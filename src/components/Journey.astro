                ></ellipse>
              </g>
              <g transform="translate(102 62) rotate(-14)">
                <ellipse
                  cx="0.8"
                  cy="1.2"
                  rx="4.6"
                  ry="2.2"
                  fill="#3D1A04"
                  opacity=".52"
                ></ellipse>
                <ellipse
                  rx="4.6"
                  ry="2.2"
                  fill="#FAF6F0"
