      </div>

      <aside class="recipe-book">
        <div class="rb-head">
          <span class="rb-title">bite-gpui</span>
          <span class="rb-badge">DROP-IN FACADE</span>
        </div>
        <p>
          Re-exports the runtime and authoring layers under a single crate. Use
          it as a direct replacement for upstream GPUI — zero view rewrites
          required.
        </p>
        <pre><code>pub use gpui_authoring::*;
pub use gpui_runtime::*;

// `use gpui::*;` compiles unchanged!</code></pre>
      </aside>
    </div>

    <!-- Filled by renderLayerInfo() when a burger layer is clicked -->
    <aside class="layer-info" id="layerInfo" aria-live="polite"></aside>

    <div class="progress">
      <i id="progressBar"></i>
    </div>
  </div>
</section>

<script>
  (() => {
    const journey = document.getElementById("journey");
    const sticky = document.getElementById("sticky");
    const bar = document.getElementById("progressBar");
    const burger = document.getElementById("burger");
    const heroCopy = document.querySelector(".hero-copy");
    const header = document.querySelector(".nav");

    // Minimum breathing room between the hero copy and the stack.
    const HERO_GAP = 48;
    const BURGER_W = 340;

    // The unstack is budgeted against the header, which is its ceiling: the
    // crown rises to the header's underside and stops there rather than
    // sliding behind it.
    const BURGER_H = 640; // .burger's frame height
    const CROWN_RIDE = 677; // runtime's --base-ex (578) + its dome's 99 units
    const HEADER_GAP = 14; // breathing room under the header bar
    const SPREAD_MAX = 110; // ceiling on the extra travel, as in global.css

    const stage = document.querySelector(".burger-stage");

    // The viewport height is locked, not read live. A mobile address bar
    // hiding fires a resize with the *same* width and a taller viewport;
    // re-deriving --scale/--spread and the scroll denominator from that snaps
    // the stack mid-unstack. Under the mobile breakpoint a height-only change
    // within browser-chrome range is ignored, so the locked height tracks the
    // 100svh units in global.css; any width change (orientation or desktop
    // resize) and any larger height change re-measure.
    const CHROME_MAX = 160; // px; ceiling on address-bar / toolbar height
    let lockedW = document.documentElement.clientWidth;
    let lockedH = document.documentElement.clientHeight;

    function measureViewport() {
      const w = document.documentElement.clientWidth;
      const h = document.documentElement.clientHeight;
      if (w === lockedW && w <= 820 && Math.abs(h - lockedH) <= CHROME_MAX)
        return false; // address-bar chrome only
      lockedW = w;
      lockedH = h;
      return true;
    }

    function measureLayout() {
      if (!sticky) return;
      const vw = lockedW;
      const vh = lockedH;

      // Assembled: the frame has to fit the viewport with breathing room.
      const scale = Math.max(0.55, Math.min(1, (vh - 80) / BURGER_H));

      // Exploded: the stage is centred, so the frame's floor sits at
      // vh/2 + height/2 and the crown's artwork reaches CROWN_RIDE above
      // that. Fitting that under the header may cost the burger some size;
      // whatever the crown does not need is handed back as --spread, which
      // is what lengthens the unstack on a tall window.
      //
      // Narrow screens pin the stage to the foot of the viewport instead
      // (see the ≤820px block in global.css), so their budget is measured
      // from the bottom rather than the centre — it has room to spare, so
      // they keep full size and their own spread rule.
      const headerH =
        (header ? header.getBoundingClientRect().height : 64) + HEADER_GAP;
      const ride = CROWN_RIDE - BURGER_H / 2;
      const budget = vh / 2 - headerH;
      const scaleOpen =
        vw <= 820 ? scale : Math.max(0.55, Math.min(1, scale, budget / ride));
      const spread =
        vw <= 820
          ? Math.max(0, Math.min(SPREAD_MAX, (vh - 760) * 0.45))
          : Math.max(0, Math.min(SPREAD_MAX, budget / scaleOpen - ride));

      sticky.style.setProperty("--scale", scale.toFixed(4));
      sticky.style.setProperty("--scale-open", scaleOpen.toFixed(4));
      sticky.style.setProperty("--spread", spread.toFixed(1) + "px");

      if (vw <= 820) {
        // The hero moves above the stack on narrow screens, so it needs no
        // room. The two --fit/--lift steps that used to be max-height media
        // queries live here instead: keyed off the locked height they cannot
        // flip when the address bar moves.
        sticky.style.setProperty("--hero-dx", "0px");
        if (stage) {
          const fit = vh <= 690 ? 0.7 : vh <= 780 ? 0.88 : 1;
          stage.style.setProperty("--fit", String(fit));
          stage.style.setProperty(
            "--lift",
            (vh * 0.01 * (vh <= 690 ? 1 : 2)).toFixed(1) + "px",
          );
        }
      } else {
        if (stage) {
          // Unused above the breakpoint; clear anything a resize left.
          stage.style.removeProperty("--fit");
          stage.style.removeProperty("--lift");
        }
        // Nudge the stack only as far as it takes to clear the hero copy.
        // Nudging it further would rob the right rail of its space.
        const heroRight = heroCopy ? heroCopy.getBoundingClientRect().right : 0;
        const burgerLeft = vw / 2 - (BURGER_W / 2) * scale;
        const dx = Math.max(0, heroRight + HERO_GAP - burgerLeft);
        sticky.style.setProperty("--hero-dx", dx + "px");
      }
    }

    function updateJourney() {
      if (!journey || !sticky) return;
      const r = journey.getBoundingClientRect();
      const travel = journey.offsetHeight - lockedH;
      const p = travel <= 0 ? 0 : Math.max(0, Math.min(1, -r.top / travel));

      const MOVE_END = 0.18;
      const EXPLODE_BEG = 0.14;
      const EXPLODE_END = 0.52;

      const move = Math.min(p / MOVE_END, 1);
      const explode = Math.max(
        0,
        Math.min((p - EXPLODE_BEG) / (EXPLODE_END - EXPLODE_BEG), 1),
      );

      sticky.style.setProperty("--move", move.toFixed(4));
      sticky.style.setProperty("--explode", explode.toFixed(4));
      if (bar) bar.style.width = (p * 100).toFixed(1) + "%";
      sticky.classList.toggle("is-exploded", explode > 0.5);
      // Captions only become click targets once they are mostly faded in.
      sticky.classList.toggle("has-captions", explode > 0.3);
      // The copy is invisible well before the tiers part—but an element at
      // opacity 0 still swallows clicks, so without this its slab sits on
      // top of the burger and eats taps meant for the layers underneath.
      sticky.classList.toggle("hero-gone", move > 0.55);
    }

    const panel = document.getElementById("layerInfo");
    const layerEls = burger ? [...burger.querySelectorAll(".layer")] : [];

    // Detail copy for the crate each burger layer represents.
    const LAYER_DATA = {
      platform: {
        path: "crates/gpui_platform",
        name: "gpui_platform",
        package: "bite-gp-platform",
        role: "OS SPI",
        accent: "var(--platform)",
        tag: "Platform contract",
        desc: "The Platform trait and the platform-level contracts: displays, input, clipboard, menus and screen capture. Each OS backend implements it, and the facade selects one by cfg(target_os).",
        depends: ["gpui_engine", "gpui_types"],
      },
      engine: {
        path: "crates/gpui_engine",
        name: "gpui_engine",
        package: "bite-gp-engine",
        role: "Render",
        accent: "var(--engine)",
        tag: "Scene IR",
        desc: "Owns the retained scene graph, the layout pass, and the renderer that flattens styled nodes into quads. It knows how to draw, not how to describe a UI.",
        depends: ["gpui_types"],
      },
      types: {
        path: "crates/gpui_types",
        name: "gpui_types",
        package: "bite-gp-types",
        role: "Leaf",
        accent: "var(--types)",
        tag: "No gpui deps",
        desc: "Pixels, Bounds, Point, Size, and Rgba: the shared vocabulary every other tier speaks. It names no other gpui crate, so it sits at the bottom of the stack; its own dependencies are third-party (taffy, serde, refineable).",
        depends: [],
      },
      authoring: {
        path: "crates/gpui_authoring",
        name: "gpui_authoring",
        package: "bite-gp-authoring",
        role: "DSL",
        accent: "var(--authoring)",
        tag: "REACTIVE UI LAYER",
        desc: "The primary authoring surface for building user interfaces. Contains the reactive entity store, declarative div() tree builders, and a window architecture split cleanly into render and event-handling phases. Lowers directly to the engine scene graph without caring how pixels are drawn.",
        depends: [
          "gpui_types",
          "gpui_engine",
          "gpui_engine_default",
          "gpui_platform",
        ],
      },
      runtime: {
        path: "crates/gpui_runtime",
        name: "gpui_runtime",
        package: "bite-gp-runtime",
        role: "Harness",
        accent: "var(--runtime)",
        tag: "Application + decorators",
        desc: "Drives the process: the Application builder, run and run_embedded, and the ThrottledPipeline and InstrumentedPipeline decorators that cap a frame rate or time the root passes of the pipeline they wrap.",
        depends: ["gpui_authoring"],
      },
    };

    let selectedLayer = null;

    function renderLayerInfo(key) {
      if (!panel) return;

      if (!key) {
        panel.classList.remove("is-visible");
        panel.innerHTML = "";
        return;
      }

      const data = LAYER_DATA[key];
      if (!data) return;

      panel.style.setProperty("--accent", data.accent);
      panel.innerHTML = `
                <div class="li-head">
                    <span class="li-path">${data.path}</span>
                    <button class="li-close" id="liClose" type="button" aria-label="Close layer info">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
                <div class="li-title-row">
                    <span class="li-name">${data.name}</span>
                    <span class="li-role">${data.role}</span>
                </div>
                <span class="li-tag">${data.tag}</span>
                <p class="li-desc">${data.desc}</p>
                <div class="li-field">
                    <span class="li-label">Depends on</span>
                    <div class="li-chips">
                        ${
                          data.depends.length
                            ? data.depends
                                .map(
                                  (crate) =>
                                    `<span class="li-chip">${crate}</span>`,
                                )
                                .join("")
                            : '<span class="li-chip is-none">nothing yet</span>'
                        }
                    </div>
                </div>
                <button class="li-cmd" type="button" aria-label="Copy cargo add ${data.package}">
                    <span class="li-cmd-text">cargo add ${data.package}</span>
                    <span class="li-cmd-icon" aria-hidden="true">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                    </span>
                </button>
            `;
      panel.classList.add("is-visible");

      panel.querySelector(".li-cmd")?.addEventListener("click", () => {
        window.copyToClipboard(
          `cargo add ${data.package}`,
          `Copied cargo add ${data.package}`,
        );
      });

      panel.querySelector("#liClose")?.addEventListener("click", (event) => {
        event.stopPropagation();
        clearSelection();
      });
    }

    function clearSelection() {
      selectedLayer = null;
      layerEls.forEach((layer) => {
        layer.classList.remove("is-selected");
        layer.setAttribute("aria-pressed", "false");
      });
      renderLayerInfo(null);
    }

    function toggleLayer(key) {
      if (!key) return;
      if (selectedLayer === key) {
        clearSelection();
        return;
      }
      selectedLayer = key;
      layerEls.forEach((layer) => {
        const isOn = layer.dataset.layer === key;
        layer.classList.toggle("is-selected", isOn);
        layer.setAttribute("aria-pressed", String(isOn));
      });
      renderLayerInfo(key);
    }

    layerEls.forEach((layer) => {
      // Clicks arriving from the slice's SVG or its caption both land here.
      layer.addEventListener("click", () => toggleLayer(layer.dataset.layer));
      layer.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        toggleLayer(layer.dataset.layer);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && selectedLayer) clearSelection();
    });

    window.addEventListener("scroll", updateJourney, { passive: true });

    document
      .getElementById("heroInstall")
      ?.addEventListener("click", function () {
        const copyVal = this.dataset.copy;
        if (copyVal) {
          window.copyToClipboard(copyVal, "Copied cargo add bite-gpui");
        }
      });

    window.addEventListener("resize", () => {
      // Ignore address-bar-only resizes so the unstack does not snap.
      if (!measureViewport()) return;
      measureLayout();
      updateJourney();
    });

    measureLayout();
    updateJourney();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => {
        measureLayout();
        updateJourney();
      });
    }
  })();
</script>
