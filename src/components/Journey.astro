            </defs>
            <!-- Contact shade cast onto the lettuce. -->
            <path
              class="crevice"
              d="M 10,44 C 10,50 68,54 140,54 C 212,54 270,50 270,44 C 270,54 214,56 140,56 C 66,56 10,54 10,44 Z"
              fill="#1A0C04"
              opacity=".9"
            ></path>
            <path
              d="M 10,22 L 10,44 C 10,50 68,54 140,54 C 212,54 270,50 270,44 L 270,22 C 270,14 212,8 140,8 C 68,8 10,14 10,22 Z"
              fill="url(#patWall)"
            ></path>
            <ellipse
              cx="140"
              cy="22"
              rx="130"
              ry="14"
              fill="url(#patTop)"
            ></ellipse>
            <!-- No caramelised edge here: the arc crossed the wall's own ramp
                             and read as a seam across the patty rather than an edge. -->
            <g
              stroke="#160702"
              stroke-width="2"
              stroke-linecap="round"
              fill="none"
              opacity=".7"
            >
              <path d="M 52,17 Q 78,24 104,18"></path>
              <path d="M 122,17 Q 148,25 174,18"></path>
              <path d="M 192,17 Q 214,23 238,18"></path>
              <path d="M 70,27 Q 94,33 118,28" stroke-width="1.2"></path>
              <path d="M 146,27 Q 170,33 194,28" stroke-width="1.2"></path>
            </g>
            <!-- Caramelised lip, from the reference. One arc tracing the front
                             edge of the seared face, where it curves into the wall. An
                             earlier attempt drew a separate highlight under each sear mark
                             instead, which stacked two lines on each other and read as an
                             embossed ridge rather than a grilled edge. -->
            <path
              d="M 16,26 C 46,33 96,36 140,36 C 184,36 234,33 264,26"
              fill="none"
              stroke="#8A5638"
              stroke-width="1.1"
              opacity=".4"
            ></path>
            <ellipse
              cx="100"
              cy="19"
              rx="28"
              ry="5"
              fill="#84482B"
              opacity=".3"
              transform="rotate(-6 100 19)"
            ></ellipse>
            <ellipse
              cx="182"
              cy="20"
              rx="26"
              ry="4.5"
              fill="#84482B"
              opacity=".25"
              transform="rotate(6 182 20)"
            ></ellipse>
          </svg>
          <div class="layer-caption">
            <div class="cap-head">
              <span class="cap-crate">gpui_authoring</span>
              <span class="cap-role">Reactive DSL</span>
            </div>
            <span class="cap-desc">
              Reactive stores, div() builders, and a window split into render
              and event halves.
            </span>
          </div>
        </div>

        <!-- TOP BUN: gpui_runtime -->
        <div
          class="layer layer-runtime"
          data-layer="runtime"
          style="--accent:var(--runtime)"
          role="button"
          tabindex="0"
          aria-pressed="false"
