---
---

<!-- ACT I & II: SCROLL-LINKED KITCHEN JOURNEY -->
<section class="journey" id="journey">
  <div class="journey-sticky" id="sticky">
    <div class="hero-copy">
      <span class="eyebrow">
        <span class="dot"></span> v1.21.0 · Modular GPUI Architecture
      </span>
      <h1>
        GPUI.
        <br />
        <em>Take a bite.</em>
      </h1>
      <h2 class="hero-subhead">Stop forking. Start swapping.</h2>
      <p class="lede">
        Zed’s GPUI is fast, but tightly coupled. <code>bite-gpui</code> breaks
        the engine into five standalone crates. Tweak the frame pipeline, drop
        in BiDi text layout, or run headless tests. Your <code>div()</code> code
        stays 100% compatible.
      </p>

      <button
        class="install-cmd"
        id="heroInstall"
        data-copy="cargo add bite-gpui"
      >
        <span class="prompt">$</span>
        <code>cargo add bite-gpui</code>
        <span class="copy-icon" aria-hidden="true">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="9" y="9" width="12" height="12" rx="2"></rect>
            <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
          </svg>
        </span>
      </button>

      <div class="scroll-hint">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 5v14M5 12l7 7 7-7"></path>
        </svg>
        Scroll to unstack the layers
      </div>
    </div>

    <!-- Burger Assembly Stage -->
    <div class="burger-stage">
      <div
        class="burger"
        id="burger"
        role="group"
        aria-label="Interactive stack of the five bite-gpui crates"
      >
        <!-- TRAY: gpui_platform -->
        <div
          class="layer layer-platform"
          data-layer="platform"
          style="--accent:var(--platform)"
          role="button"
          tabindex="0"
          aria-pressed="false"
          aria-label="gpui_platform — Platform SPI"
        >
          <svg viewBox="0 0 340 70" aria-hidden="true">
            <defs>
              <linearGradient id="trayG" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#ADA79E"></stop>
                <stop offset=".45" stop-color="#85807A"></stop>
                <stop offset="1" stop-color="#37332F"></stop>
              </linearGradient>
              <radialGradient id="trayS" cx=".35" cy=".3" r=".7">
                <stop offset="0" stop-color="#fff" stop-opacity=".22"></stop>
                <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
              </radialGradient>
              <!-- warm bounce picked up from the burger resting on the tray -->
              <radialGradient id="trayWarm" cx=".5" cy=".5" r=".55">
                <stop offset="0" stop-color="#D5B895" stop-opacity=".26"></stop>
                <stop offset="1" stop-color="#D5B895" stop-opacity="0"></stop>
              </radialGradient>
            </defs>
            <!-- No drawn ground shadow: the CSS drop-shadow on .burger already
                             grounds the stack, and a second dark ellipse here read as a
                             ghost disc drifting out from under the plate. -->
            <ellipse cx="170" cy="40" rx="160" ry="24" fill="#302C2A"></ellipse>
            <ellipse
              cx="170"
              cy="30"
              rx="160"
              ry="24"
              fill="url(#trayG)"
            ></ellipse>
            <ellipse
              cx="170"
              cy="30"
              rx="160"
              ry="24"
              fill="none"
              stroke="#B5AFA7"
              stroke-width="1"
              opacity=".4"
            ></ellipse>
            <ellipse
              cx="170"
              cy="30"
              rx="140"
              ry="19"
              fill="none"
              stroke="#fff"
              stroke-width="1"
              opacity=".12"
            ></ellipse>
            <ellipse
              cx="170"
              cy="31"
              rx="132"
              ry="18"
              fill="#241F1B"
              opacity=".45"
            ></ellipse>
            <ellipse
              cx="170"
              cy="30"
              rx="126"
              ry="15"
              fill="url(#trayWarm)"
            ></ellipse>
            <ellipse
              cx="120"
              cy="18"
              rx="72"
              ry="6"
              fill="url(#trayS)"
            ></ellipse>
          </svg>
          <div class="layer-caption">
            <div class="cap-head">
              <span class="cap-crate">gpui_platform</span>
              <span class="cap-role">Platform SPI</span>
            </div>
            <span class="cap-desc">
              Hardware and OS bindings. One of macOS, Linux, Windows or Web
              compiles in via cfg(target_os).
            </span>
          </div>
        </div>

        <!-- BOTTOM BUN: gpui_engine -->
        <div
          class="layer layer-engine"
          data-layer="engine"
          style="--accent:var(--engine)"
          role="button"
          tabindex="0"
          aria-pressed="false"
          aria-label="gpui_engine — Scene &amp; Render"
        >
          <svg viewBox="0 0 300 82" aria-hidden="true">
            <defs>
              <linearGradient id="bbWall" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#E0A863"></stop>
                <stop offset=".3" stop-color="#C07C36"></stop>
                <stop offset=".62" stop-color="#7A3F12"></stop>
                <stop offset=".85" stop-color="#4A2408"></stop>
                <stop offset="1" stop-color="#2A1305"></stop>
              </linearGradient>
              <radialGradient id="bbCrumb" cx=".48" cy=".42" r=".6">
                <stop offset="0" stop-color="#FFF8ED"></stop>
                <stop offset=".3" stop-color="#FCE0BC"></stop>
                <stop offset=".65" stop-color="#E2B175"></stop>
                <stop offset=".88" stop-color="#B47228"></stop>
                <stop offset="1" stop-color="#7A3E10"></stop>
              </radialGradient>
              <radialGradient id="bbSheen" cx=".5" cy=".45" r=".55">
                <stop offset="0" stop-color="#FFE8C7" stop-opacity=".5"></stop>
                <stop offset=".6" stop-color="#E8A958" stop-opacity=".3"></stop>
                <stop offset="1" stop-color="#BC6E1E" stop-opacity="0"></stop>
              </radialGradient>
            </defs>
            <!-- Contact shade cast onto the tray. Tapers to nothing where the heel curves away. -->
            <path
              class="crevice"
              d="M 10,46 C 10,58 72,68 150,68 C 228,68 290,58 290,46 C 290,58 232,72 150,72 C 68,72 10,58 10,46 Z"
              fill="#1A0C04"
              opacity=".9"
            ></path>
            <!-- Wall and curved heel are one silhouette on a single vertical ramp, so the
                             base is a shaded cylinder bottom rather than a dark disc behind it. -->
            <path
              d="M 10,22 L 10,46 C 10,58 72,68 150,68 C 228,68 290,58 290,46 L 290,22 C 290,10 228,0 150,0 C 72,0 10,10 10,22 Z"
              fill="url(#bbWall)"
            ></path>
            <ellipse
              cx="150"
              cy="22"
              rx="140"
              ry="22"
              fill="url(#bbCrumb)"
            ></ellipse>
            <ellipse
              cx="149"
              cy="21"
              rx="118"
              ry="17"
              fill="url(#bbSheen)"
            ></ellipse>
            <!-- Ambient rim light along the plancha cut, from the reference. -->
            <path
              d="M 12,22 C 12,36 74,43 150,43 C 226,43 288,36 288,22"
              fill="none"
              stroke="#F5CB8E"
              stroke-width="1.3"
              opacity=".4"
            ></path>
          </svg>
          <div class="layer-caption">
            <div class="cap-head">
              <span class="cap-crate">gpui_engine</span>
              <span class="cap-role">Scene &amp; Render</span>
            </div>
            <span class="cap-desc">
              Scene intermediate representation (IR), text layout bindings, and
              renderer traits.
            </span>
          </div>
        </div>

        <!-- LETTUCE: gpui_types -->
        <div
          class="layer layer-types"
          data-layer="types"
          style="--accent:var(--types)"
          role="button"
          tabindex="0"
          aria-pressed="false"
          aria-label="gpui_types — Zero-dep Leaf"
        >
          <svg viewBox="0 0 320 44" aria-hidden="true">
            <defs>
              <linearGradient id="letG" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#B0CBBB"></stop>
                <stop offset=".5" stop-color="#8AA694"></stop>
                <stop offset="1" stop-color="#62806D"></stop>
              </linearGradient>
              <!-- Silky sheen across the leaf. A radial gradient rather than the
                                 reference's blur filter: this layer repaints on every scroll frame. -->
              <radialGradient id="letSilk" cx=".5" cy=".5" r=".5">
                <stop offset="0" stop-color="#A4CBB6" stop-opacity=".42"></stop>
                <stop
                  offset=".6"
                  stop-color="#A4CBB6"
                  stop-opacity=".18"
                ></stop>
                <stop offset="1" stop-color="#A4CBB6" stop-opacity="0"></stop>
              </radialGradient>
              <!-- Occlusion where the leaf tucks under the patty. A radial gradient
                                 rather than a ramp across the whole silhouette: the leaf's tips
                                 reach wider than the patty, and a ramp darkened them into a
                                 dark green wing under the patty's lip that read as a ghost
                                 shadow rather than as leaf. This one fades out at the patty's
                                 own width, so the tips stay leaf-coloured, and it is clipped
                                 to the silhouette so it can never paint outside the leaf. -->
              <radialGradient id="letOcclusion" cx=".5" cy=".5" r=".5">
                <stop offset="0" stop-color="#1A0C04" stop-opacity=".55"></stop>
                <stop
                  offset=".55"
                  stop-color="#1A0C04"
                  stop-opacity=".26"
                ></stop>
                <stop offset="1" stop-color="#1A0C04" stop-opacity="0"></stop>
              </radialGradient>
              <clipPath id="letClip">
                <path d="M 19,18 C 20,9 25,2.4 35,0.9 C 76,5.6 118,10.6 160,10.6 C 202,10.6 244,5.6 285,0.9 C 295,2.4 300,9 301,18 C 302,25 298,29 291,30 C 270,33 240,31 214,30.2 C 196,29.6 178,29.4 160,29.4 C 142,29.4 124,29.6 106,30.2 C 80,31 50,33 29,30 C 22,29 18,25 19,18 Z"></path>
              </clipPath>
            </defs>
            <!-- Contact shade cast onto the bottom bun: the leaf's own silhouette shifted
                             down, so the shade follows the lower edge exactly. -->
            <path
              class="crevice"
              transform="translate(0 3)"
              d="M 19,18 C 20,9 25,2.4 35,0.9 C 76,5.6 118,10.6 160,10.6 C 202,10.6 244,5.6 285,0.9 C 295,2.4 300,9 301,18 C 302,25 298,29 291,30 C 270,33 240,31 214,30.2 C 196,29.6 178,29.4 160,29.4 C 142,29.4 124,29.6 106,30.2 C 80,31 50,33 29,30 C 22,29 18,25 19,18 Z"
              fill="#1A0C04"
              opacity=".9"
            ></path>
            <!-- The silhouette's upper edge tracks the patty's base arc, so it hides
                             behind the patty; the tips then drop away either side well below
                             that arc, which is what stops them reading as wings pinned to the
                             patty's underside. -->
            <path
              d="M 19,18 C 20,9 25,2.4 35,0.9 C 76,5.6 118,10.6 160,10.6 C 202,10.6 244,5.6 285,0.9 C 295,2.4 300,9 301,18 C 302,25 298,29 291,30 C 270,33 240,31 214,30.2 C 196,29.6 178,29.4 160,29.4 C 142,29.4 124,29.6 106,30.2 C 80,31 50,33 29,30 C 22,29 18,25 19,18 Z"
              fill="url(#letG)"
              stroke="#54705F"
              stroke-width=".9"
            ></path>
            <ellipse
              cx="160"
              cy="20"
              rx="112"
              ry="8"
              fill="url(#letSilk)"
            ></ellipse>
            <g clip-path="url(#letClip)">
              <ellipse
                cx="160"
                cy="10"
                rx="131"
                ry="14"
                fill="url(#letOcclusion)"
              ></ellipse>
            </g>
            <!-- No veins. A lit rib line this thin reads as a scratch across the
                             leaf at the size the hero renders, and the curled frill lobes that
                             preceded it read as three leaves of another variety lying on top.
                             The silhouette, the silk sheen and the occlusion carry the form. -->
          </svg>
          <div class="layer-caption">
            <div class="cap-head">
              <span class="cap-crate">gpui_types</span>
              <span class="cap-role">Zero-dep Leaf</span>
            </div>
            <span class="cap-desc">
              Pixels, Bounds, Point, and Rgba. Pure geometry primitives with
              zero GPUI dependencies.
            </span>
          </div>
        </div>

        <!-- PATTY: gpui_authoring -->
        <div
          class="layer layer-authoring"
          data-layer="authoring"
          style="--accent:var(--authoring)"
          role="button"
          tabindex="0"
          aria-pressed="false"
          aria-label="gpui_authoring — Reactive DSL"
        >
          <svg viewBox="0 0 280 72" aria-hidden="true">
            <defs>
              <linearGradient id="patWall" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#8A5638"></stop>
                <stop offset=".3" stop-color="#6B4029"></stop>
                <stop offset=".55" stop-color="#4E2A18"></stop>
                <stop offset=".8" stop-color="#3A1F11"></stop>
                <stop offset="1" stop-color="#26120A"></stop>
