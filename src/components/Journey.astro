                  fill="#3D1A04"
                  opacity=".52"
                ></ellipse>
                <ellipse
                  rx="4.6"
                  ry="2.2"
                  fill="#FAF6F0"
                  opacity=".94"
                ></ellipse>
              </g>
              <g transform="translate(58 62) rotate(10)">
                <ellipse
                  cx="0.8"
