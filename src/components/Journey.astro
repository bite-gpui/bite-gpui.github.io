                  opacity=".52"
                ></ellipse>
                <ellipse
                  rx="4.6"
                  ry="2.2"
                  fill="#FAF6F0"
                  opacity=".94"
                ></ellipse>
              </g>
              <g transform="translate(172 36) rotate(-8)">
                <ellipse
                  cx="0.8"
                  cy="1.2"
                  rx="4.6"
                  ry="2.2"
                  fill="#3D1A04"
                  opacity=".52"
                ></ellipse>
                <ellipse
                  rx="4.6"
                  ry="2.2"
                  fill="#FAF6F0"
                  opacity=".94"
                ></ellipse>
              </g>
              <g transform="translate(218 50) rotate(22)">
                <ellipse
                  cx="0.8"
                  cy="1.2"
                  rx="4.6"
                  ry="2.2"
                  fill="#3D1A04"
                  opacity=".52"
                ></ellipse>
                <ellipse
                  rx="4.6"
                  ry="2.2"
                  fill="#FAF6F0"
