            <path
              d="M 14,76 C 14,89 64,99 150,99 C 236,99 286,89 286,76"
              fill="none"
              stroke="#F5CB8E"
              stroke-width="1.2"
              opacity=".3"
            ></path>
            <ellipse
              cx="112"
              cy="32"
              rx="68"
              ry="22"
              fill="url(#topSheen)"
              transform="rotate(-14 106 30)"
            ></ellipse>
            <path
              d="M 78,22 C 100,13 134,14 152,22 C 134,19 100,18 78,22 Z"
              fill="#FFFFFF"
              opacity=".55"
            ></path>
            <g>
              <g transform="translate(78 46) rotate(-25)">
