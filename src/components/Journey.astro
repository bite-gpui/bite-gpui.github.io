                <stop offset=".22" stop-color="#D5B895"></stop>
                <stop offset=".58" stop-color="#A06C38"></stop>
                <stop offset=".86" stop-color="#693B10"></stop>
                <stop offset="1" stop-color="#351B06"></stop>
              </radialGradient>
              <radialGradient id="topSheen" cx=".5" cy=".5" r=".5">
                <stop offset="0" stop-color="#FFF8EE" stop-opacity=".5"></stop>
                <stop
                  offset=".55"
                  stop-color="#FFF8EE"
                  stop-opacity=".22"
                ></stop>
                <stop offset="1" stop-color="#FFF8EE" stop-opacity="0"></stop>
              </radialGradient>
            </defs>
            <!-- Contact shade as a crescent that traces the underside and tapers to nothing
                             at the lip. A full ellipse would protrude past the lip at both sides and
                             read as a dark lobe floating behind the bun. -->
            <path
              d="M 10,74 C 12,88 66,101 150,101 C 234,101 288,88 290,74 C 290,90 236,106 150,106 C 64,106 10,90 10,74 Z"
              class="crevice"
              fill="#1A0C04"
              opacity=".9"
            ></path>
            <path
