---
---

<!-- ACT III: COMBO STUDIO (TWO-STAGE SIDES & BEVERAGE BUILDER) -->
<section class="combo" id="capabilities">
    <div class="container">
        <header class="studio-head">
            <div class="section-head">
                <span class="kicker">
                    <i class="kicker-dot" aria-hidden="true"></i>Combo Studio ·
                    Sides &amp; Beverages
                </span>
                <h2>Anything Else?</h2>
                <p>
                    Everything on this menu is decoupled. Attach text-layout and
                    frame-pacing sides (Step 1), then select your target
                    beverage driver (Step 2). Application views never recompile.
                </p>
            </div>

            <div class="studio-head-actions">
                <!-- Stepper Navigation -->
                <div
                    class="studio-stepper"
                    role="tablist"
                    aria-label="Studio Configuration Stepper"
                >
                    <button
                        class="stepper-btn is-active"
                        id="stepBtnCondiments"
                        data-stage="condiments"
                        role="tab"
                        aria-selected="true"
                    >
                        <span class="step-index">1</span>
                        <span>🥫 Sides &amp; Condiments</span>
                        <span class="step-chip" id="condimentCountChip">
                            0 active
                        </span>
                    </button>
                    <span class="stepper-divider">➔</span>
                    <button
                        class="stepper-btn"
                        id="stepBtnBeverages"
                        data-stage="beverages"
                        role="tab"
                        aria-selected="false"
                    >
                        <span class="step-index">2</span>
                        <span>🥤 Beverage Driver</span>
                        <span class="step-chip" id="beverageTargetChip">
                            macOS
                        </span>
                    </button>
                </div>
            </div>
        </header>

        <div class="combo-layout" id="comboLayout" data-mobile-tab="configure">
            <!-- MOBILE SWITCHER: Configure ⇄ Code -->
            <div
                class="combo-mobile-tabs"
                id="comboMobileTabs"
                role="group"
                aria-label="Studio view"
            >
                <button
                    class="combo-mobile-tab is-active"
                    id="mobileTabConfigure"
                    type="button"
                    aria-pressed="true"
                    aria-controls="panelConfigure"
                >
                    <span>🛠️ Configure</span>
                    <span class="combo-mobile-tab-chip" id="mobileConfigCount">
                        0 of 4
                    </span>
                </button>
                <button
                    class="combo-mobile-tab"
                    id="mobileTabCode"
                    type="button"
                    aria-pressed="false"
                    aria-controls="panelCode"
                >
                    <span>💻 View Code</span>
                    <span class="combo-mobile-tab-chip" id="mobileCodeCount">
                        0 injected
                    </span>
                </button>
            </div>

            <!-- LEFT COLUMN: CONFIGURE (SCRATCH DOCK + DETAIL) -->
            <div class="combo-panel combo-panel-config" id="panelConfigure">
                <div class="dock-wrapper" id="dockWrapper">
                    <div class="dock-shelf-title">
                        <strong id="dockShelfHeader">
                            Additive Sides &amp; Condiments
                        </strong>
                        <span id="dockShelfSub">
                            Attach as many crate-level sides as you like; they
                            compose into the frame pipeline.
                        </span>
                    </div>

                    <div
                        class="dock-buttons-group"
                        id="dockButtonsGroup"
                        role="group"
                        aria-label="Interactive option toggles"
                    >
                        <!-- Populated by renderDock() -->
                    </div>

                    <!-- Docked one-line footer: it carries the stage summary by
                         default and becomes the hovered option's doc-comment
                         while a row is read, so no separate detail card is
                         needed. -->
                    <div class="dock-foot">
                        <span class="dock-foot-text" id="dockFootText">
                            3 additive sides attached
                        </span>
                        <span class="dock-foot-mark" id="dockFootMark">
                            Zero engine forks
                        </span>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: DUAL-FILE TERMINAL INSPECTOR -->
            <aside
                class="order-card combo-panel combo-panel-code"
                id="panelCode"
                aria-live="polite"
            >
                <div class="order-head">
                    <div style="display:flex;align-items:center;gap:12px;">
                        <div class="terminal-dots" aria-hidden="true">
                            <span class="terminal-dot close"></span>
                            <span class="terminal-dot min"></span>
                            <span class="terminal-dot zoom"></span>
                        </div>
                        <!-- Dual-File Tabs -->
                        <div class="terminal-file-tabs">
                            <button
                                class="t-file-btn is-active"
                                id="tabMainFile"
                                data-file="main"
                            >
                                <svg
                                    width="12"
                                    height="12"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                >
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                </svg>
                                <span id="tabMainFileLabel">main.rs</span>
                            </button>
                            <button
                                class="t-file-btn"
                                id="tabCargoFile"
                                data-file="cargo"
                            >
                                <svg
                                    width="12"
                                    height="12"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                >
                                    <rect
                                        x="3"
                                        y="3"
                                        width="18"
                                        height="18"
                                        rx="2"
                                    ></rect>
                                    <path d="M9 3v18M15 3v18M3 9h18M3 15h18"></path>
                                </svg>
                                <span>Cargo.toml</span>
                            </button>
                        </div>
                    </div>

                    <div class="order-actions">
                        <span class="order-badge" id="orderBadge">
                            <span
                                class="order-badge-dot"
                                aria-hidden="true"
                            ></span>
                            <span id="orderBadgeText">Crisp Apple Fizz</span>
                        </span>
                        <button class="copy-code" id="copyCode">
                            <svg
                                width="12"
                                height="12"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <rect
                                    x="9"
                                    y="9"
                                    width="12"
                                    height="12"
                                    rx="2"
                                ></rect>
                                <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
                            </svg>
                            <span>Copy</span>
                        </button>
                    </div>
                </div>

                <ol class="code-lines-container" id="codeLinesList"></ol>

                <!-- One flat status line divided by hairline rules, the way a
                     native editor reads, instead of four boxed tiles. -->
                <div class="order-status">
                    <div class="order-status-metrics">
                        <span class="order-status-item">
                            Shaping: <strong id="mGlyph">835 ms</strong>
                        </span>
                        <span class="order-status-sep" aria-hidden="true">
                            │
                        </span>
                        <span class="order-status-item">
                            Layout: <strong id="mLayout">28.5 ms</strong>
                        </span>
                        <span class="order-status-sep" aria-hidden="true">
                            │
                        </span>
                        <span class="order-status-item">
                            Cadence: <strong id="mFps">Uncapped</strong>
                        </span>
                        <span class="order-status-sep" aria-hidden="true">
                            │
                        </span>
                        <span class="order-status-item">
                            Driver:{" "}
                            <strong id="mPlatform">macOS (Metal)</strong>
                        </span>
                    </div>
                    <span class="order-status-note">0 view-layer rebuilds</span>
                </div>
            </aside>
        </div>
    </div>
</section>

<script>
    (() => {
        // Current active configuration
        let currentStage = "condiments"; // 'condiments' | 'beverages'
        let currentActiveFile = "main"; // 'main' | 'cargo'

        // Step 1: additive crates (checkboxes), each dressed as a side.
        const condimentsState = {
            parley: true,
            pacing: true,
            surface: true,
            profiler: false,
        };

        // Step 2: mutually exclusive radio (default macOS)
        let activeBeverage = "macos"; // 'macos' | 'linux' | 'windows' | 'headless'

        let mobileTab = "configure"; // 'configure' | 'code' (mobile cockpit)

        // SIDE DATA (Step 1 — additive crates, each with a condiment identity)
        const CONDIMENT_DATA = {
            parley: {
                key: "parley",
                type: "condiment",
                name: "Parley Text Engine",
                crate: "gpui_parley",
                pill: "🥫 PARLEY",
                sub: "🌶️ Sriracha · BiDi layout, complex scripts & fallback",
                kicker: "Linebender Typography",
                desc: "Unicode BiDi layout, complex-script shaping and system font fallback from Linebender Parley, rasterised through Skrifa and tiny-skia.",
                specTrait: "Arc<dyn TextSystem>",
                specImpact: "835 ms ➔ 2.1 ms glyph paint",
                color: "#C77158",
                colorLight: "#9E4027",
                svg: '<svg viewBox="0 0 56 56"><ellipse cx="28" cy="48" rx="14" ry="3.5" fill="#000" opacity=".35"/><path d="M18 20 L38 20 L36 48 Q28 52 20 48 Z" fill="#7F1D1D"/><path d="M18 20 L38 20 L37 26 L19 26 Z" fill="#B91C1C"/><ellipse cx="28" cy="20" rx="10" ry="2.5" fill="#DC2626"/><rect x="24" y="6" width="8" height="12" rx="1.5" fill="#450A0A"/><path d="M26 6 L30 6 L30 2 L26 2 Z" fill="#FCA5A5"/></svg>',
            },
            pacing: {
                key: "pacing",
                type: "condiment",
                name: "Frame Governor",
                crate: "gpui_pacing",
                pill: "🍯 MUSTARD",
                sub: "🍯 Dijon Mustard · 60 FPS vsync lock & GPU runaway stop",
                kicker: "Pacing Controller",
                desc: "Locks the frame loop to a deterministic cadence and stops GPU runaway on idle frames, absorbing display-refresh jitter.",
                specTrait: "FramePipelineDecorator",
                specImpact: "Deterministic 60 FPS cadence",
                color: "#C9B486",
                colorLight: "#74591A",
                svg: '<svg viewBox="0 0 56 56"><ellipse cx="28" cy="48" rx="13" ry="3.5" fill="#000" opacity=".35"/><path d="M20 22 L36 22 L34 48 Q28 51 22 48 Z" fill="#854D0E"/><path d="M20 22 L36 22 L35 28 L21 28 Z" fill="#CA8A04"/><ellipse cx="28" cy="22" rx="8" ry="2.2" fill="#FACC15"/><rect x="25" y="10" width="6" height="12" rx="1.2" fill="#422006"/></svg>',
            },
            surface: {
                key: "surface",
                type: "condiment",
                name: "WGPU Surface Pass",
                crate: "gpui_wgpu_surface",
                pill: "🌮 NACHOS",
                sub: "🌮 Loaded Nachos · Raw 3D render-pass blit & custom shaders",
                kicker: "Surface Escape Hatch",
                desc: "Blit raw wgpu render passes, embedded 3D viewports or video decoders straight into GPUI's draw-quad list, without forking the engine.",
                specTrait: "Style::custom",
                specImpact: "Zero engine forks",
                color: "#D9A55F",
                colorLight: "#7A5414",
                svg: '<svg viewBox="0 0 56 56"><ellipse cx="28" cy="48" rx="16" ry="3.5" fill="#000" opacity=".35"/><path d="M10 40 Q10 24 28 24 Q46 24 46 40 Q28 46 10 40 Z" fill="#7C2D12"/><path d="M12 38 Q14 28 28 28 Q42 28 44 38 Q28 42 12 38 Z" fill="#B45309"/><path d="M20 30 L26 26 L32 30 Z" fill="#FBBF24"/><path d="M30 32 L36 28 L42 32 Z" fill="#FBBF24"/></svg>',
            },
            profiler: {
                key: "profiler",
                type: "condiment",
                name: "Layout Profiler",
                crate: "gpui_telemetry",
                pill: "🥒 RELISH",
                sub: "🥒 Sweet Relish · Microsecond trace spans for shaping & layout",
                kicker: "Telemetry Middleware",
                desc: "Sub-millisecond trace spans for text shaping, layout and scene compilation, with no logging noise injected into your views.",
                specTrait: "InstrumentedPipeline",
                specImpact: "Per-pass profiler traces",
                color: "#8FA89B",
                colorLight: "#2F5A3D",
                svg: '<svg viewBox="0 0 56 56"><ellipse cx="28" cy="48" rx="15" ry="3.5" fill="#000" opacity=".35"/><path d="M16 22 L40 22 L42 46 Q28 50 14 46 Z" fill="#14532D"/><path d="M16 22 L40 22 L40.5 26 L15.5 26 Z" fill="#166534"/><ellipse cx="28" cy="22" rx="12" ry="3" fill="#15803D"/><ellipse cx="28" cy="16" rx="12" ry="5" fill="#22C55E"/></svg>',
            },
        };

        // BEVERAGE DATA (Step 2 — mutually exclusive platform drivers)
        const BEVERAGE_DATA = {
            macos: {
                key: "macos",
                type: "beverage",
                name: "macOS (Metal)",
                short: "macOS",
                beverage: "Crisp Apple Fizz",
                tag: "METAL",
                kicker: "Platform Driver · macOS",
                crate: "gpui_platform_macos",
                sub: "🍏 Crisp Apple Fizz · Cocoa CFRunLoop + CAMetalLayer",
                cargoTarget: `target.'cfg(target_os = "macos")'.dependencies`,
                color: "#9FC0BC",
                colorLight: "#366A66",
                desc: "Native Cocoa CFRunLoop paired with a CAMetalLayer surface swapchain.",
                specTrait: "CAMetalLayer + Cocoa Loop",
                specImpact: "0 lines changed in main.rs",
                svg: '<svg viewBox="0 0 56 56"><ellipse cx="28" cy="50" rx="14" ry="3.5" fill="#000" opacity=".35"/><path d="M17 18 L39 18 L36 48 Q28 51 20 48 Z" fill="#0369A1"/><path d="M17 18 L39 18 L38 24 L18 24 Z" fill="#0284C7"/><ellipse cx="28" cy="18" rx="11" ry="2.6" fill="#38BDF8"/><path d="M28 6 Q30 12 34 14" stroke="#F43F5E" stroke-width="2.2" fill="none" stroke-linecap="round"/><circle cx="28" cy="32" r="4.5" fill="#E0F2FE" opacity=".8"/></svg>',
            },
            linux: {
                key: "linux",
                type: "beverage",
                name: "Linux (Vulkan)",
                short: "Linux",
                beverage: "Open-Source Cola",
                tag: "VULKAN",
                kicker: "Platform Driver · Linux",
                crate: "gpui_platform_linux",
                sub: "🥤 Open-Source Cola · Wayland & X11 with an ash Vulkan swapchain",
                cargoTarget: `target.'cfg(target_os = "linux")'.dependencies`,
                color: "#D9A55F",
                colorLight: "#7A5414",
                desc: "Wayland and X11 event dispatcher with an ash Vulkan surface swapchain.",
                specTrait: "Wayland/X11 + Vulkan",
                specImpact: "0 lines changed in main.rs",
                svg: '<svg viewBox="0 0 56 56"><ellipse cx="28" cy="50" rx="14" ry="3.5" fill="#000" opacity=".35"/><path d="M18 18 L38 18 L35 48 Q28 51 21 48 Z" fill="#78350F"/><path d="M18 18 L38 18 L37 24 L19 24 Z" fill="#B45309"/><ellipse cx="28" cy="18" rx="10" ry="2.5" fill="#F59E0B"/><path d="M25 10 L31 10 L30 18 L26 18 Z" fill="#D97706"/><circle cx="28" cy="33" r="4.5" fill="#FEF3C7" opacity=".8"/></svg>',
            },
            windows: {
                key: "windows",
                type: "beverage",
                name: "Windows (Direct3D 12)",
                short: "Windows",
                beverage: "Direct3D Punch",
                tag: "DX12",
                kicker: "Platform Driver · Windows",
                crate: "gpui_platform_windows",
                sub: "🧊 Direct3D Punch · Win32 event queue + DX12 swapchain blit",
                cargoTarget: `target.'cfg(target_os = "windows")'.dependencies`,
                color: "#9BA3C0",
                colorLight: "#4A5480",
                desc: "Win32 event queue paired with a Direct3D 12 swapchain blit, selected purely by cfg(target_os).",
                specTrait: "Win32 Dispatch + D3D12",
                specImpact: "0 lines changed in main.rs",
                svg: '<svg viewBox="0 0 56 56"><ellipse cx="28" cy="50" rx="14" ry="3.5" fill="#000" opacity=".35"/><path d="M17 18 L39 18 L36 48 Q28 51 20 48 Z" fill="#1E3A8A"/><path d="M17 18 L39 18 L38 24 L18 24 Z" fill="#2563EB"/><ellipse cx="28" cy="18" rx="11" ry="2.6" fill="#60A5FA"/><rect x="23" y="10" width="10" height="4" rx="1" fill="#93C5FD"/><circle cx="28" cy="32" r="4.5" fill="#DBEAFE" opacity=".8"/></svg>',
            },
            headless: {
                key: "headless",
                type: "beverage",
                name: "Headless CI",
                short: "CI",
                beverage: "In-Memory Soda",
                tag: "NULL",
                kicker: "Platform Driver · Headless CI",
                crate: "gpui_platform_null",
                sub: "🧪 In-Memory Soda · Software framebuffers for zero-GPU CI",
                cargoTarget: `target.'cfg(target_os = "none")'.dependencies`,
                color: "#8E8781",
                colorLight: "#5E5852",
                desc: "Pure in-memory software framebuffers, so the whole integration suite runs in CI with no display server and zero Xvfb flakiness.",
                specTrait: "Software Framebuffer",
                specImpact: "0 MB CI display footprint",
                svg: '<svg viewBox="0 0 56 56"><ellipse cx="28" cy="50" rx="14" ry="3.2" fill="#000" opacity=".35"/><path d="M16 18 L40 18 L36 48 Q28 51 20 48 Z" fill="#334155"/><path d="M16 18 L40 18 L38 24 L18 24 Z" fill="#475569"/><ellipse cx="28" cy="18" rx="12" ry="2.8" fill="#64748B"/><rect x="20" y="12" width="16" height="4" rx="1.2" fill="#1E293B"/></svg>',
            },
            wasm: {
                key: "wasm",
                type: "beverage",
                name: "WebAssembly & Embedded",
                short: "WASM",
                beverage: "Web Seltzer",
                tag: "WASM",
                kicker: "Platform Driver · wasm32",
                crate: "gpui_platform_web",
                sub: "🧃 Web Seltzer · wasm32 canvas + JS event loop",
                cargoTarget: `target.'cfg(target_arch = "wasm32")'.dependencies`,
                color: "#A79BC0",
                colorLight: "#5F5480",
                desc: "The same view code compiled to wasm32 for the browser or an embedded canvas. It is the one driver that changes the entry point: embedded() rather than application(), behind a #[wasm_bindgen(start)] that returns the run handle to the JS host.",
                specTrait: "embedded() + wasm-bindgen",
                specImpact: "embedded() · handle returned to JS",
                svg: '<svg viewBox="0 0 56 56"><ellipse cx="28" cy="50" rx="14" ry="3.5" fill="#000" opacity=".35"/><path d="M17 18 L39 18 L36 48 Q28 51 20 48 Z" fill="#4E4577"/><path d="M17 18 L39 18 L38 24 L18 24 Z" fill="#6E62A0"/><ellipse cx="28" cy="18" rx="11" ry="2.6" fill="#A79BC0"/><circle cx="28" cy="33" r="5.2" fill="none" stroke="#E7E1F5" stroke-width="1.3"/><path d="M22.8 33h10.4M28 27.8v10.4" stroke="#E7E1F5" stroke-width="1.1"/></svg>',
            },
        };

        // Accent colours are per-option data, not theme tokens, so each option
        // carries a darker `colorLight` variant for the sage-paper theme. The
        // fixed crate palette retints itself through the CSS tokens in global.css.
        const accentOf = (item) =>
            document.documentElement.dataset.theme === "light" &&
            item.colorLight
                ? item.colorLight
                : item.color;

        // DOM elements
        const stepBtnCondiments = document.getElementById("stepBtnCondiments");
        const stepBtnBeverages = document.getElementById("stepBtnBeverages");
        const condimentCountChip =
            document.getElementById("condimentCountChip");
        const beverageTargetChip =
            document.getElementById("beverageTargetChip");

        const dockShelfHeader = document.getElementById("dockShelfHeader");
        const dockShelfSub = document.getElementById("dockShelfSub");
        const dockButtonsGroup = document.getElementById("dockButtonsGroup");
        const dockFootText = document.getElementById("dockFootText");
        const dockFootMark = document.getElementById("dockFootMark");

        const codeList = document.getElementById("codeLinesList");
        const copyBtn = document.getElementById("copyCode");
        const orderBadge = document.getElementById("orderBadge");
        const orderBadgeText = document.getElementById("orderBadgeText");

        const tabMainFile = document.getElementById("tabMainFile");
        const tabCargoFile = document.getElementById("tabCargoFile");
        const tabMainFileLabel = document.getElementById("tabMainFileLabel");

        const mGlyph = document.getElementById("mGlyph");
        const mLayout = document.getElementById("mLayout");
        const mFps = document.getElementById("mFps");
        const mPlatform = document.getElementById("mPlatform");

        const comboLayout = document.getElementById("comboLayout");
        const mobileTabConfigure =
            document.getElementById("mobileTabConfigure");
        const mobileTabCode = document.getElementById("mobileTabCode");
        const mobileConfigCount = document.getElementById("mobileConfigCount");
        const mobileCodeCount = document.getElementById("mobileCodeCount");

        // The dock's docked footer. By default it summarises the current stage;
        // while a row is hovered or focused it becomes that option's doc-comment,
        // which is what the removed detail card used to carry.
        function renderDockFoot(preview) {
            if (!dockFootText || !dockFootMark) return;

            if (preview) {
                dockFootText.textContent = `${preview.name} — ${preview.desc}`;
                dockFootMark.textContent = `${preview.specTrait} · ${preview.specImpact}`;
                return;
            }

            if (currentStage === "condiments") {
                const activeCount =
                    Object.values(condimentsState).filter(Boolean).length;
                dockFootText.textContent = `${activeCount} additive side${
                    activeCount === 1 ? "" : "s"
                } attached`;
                dockFootMark.textContent = "Zero engine forks";
            } else {
                const bev = BEVERAGE_DATA[activeBeverage];
                dockFootText.textContent = `Platform: ${bev.name}`;
                dockFootMark.textContent = "Zero OS driver lock-in";
            }
        }

        // Render dock buttons (condiments vs beverages)
        function renderDock() {
            if (!dockButtonsGroup) return;
            dockButtonsGroup.innerHTML = "";

            const isCondiments = currentStage === "condiments";

            // Drives the toggle-switch (checkboxes) vs radio-dial styling in CSS.
            dockButtonsGroup.classList.toggle("dock-condiments", isCondiments);
            dockButtonsGroup.classList.toggle("dock-beverages", !isCondiments);

            dockShelfHeader.textContent = isCondiments
                ? "Additive Sides & Condiments"
                : "Target Beverage Driver (Pick One)";
            dockShelfSub.textContent = isCondiments
                ? "Attach as many crate-level sides as you like; they compose into the frame pipeline."
                : "A build targets exactly one platform driver at a time, resolved from Cargo.toml.";

            const items = isCondiments
                ? Object.values(CONDIMENT_DATA)
                : Object.values(BEVERAGE_DATA);

            items.forEach((item) => {
                const isActive = isCondiments
                    ? !!condimentsState[item.key]
                    : activeBeverage === item.key;

                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "dock-row";
                btn.dataset.itemKey = item.key;
                btn.dataset.itemType = item.type;
                btn.dataset.active = String(isActive);
                btn.style.setProperty("--accent", accentOf(item));
                btn.title = `${item.name} (${item.crate})`;
                btn.setAttribute("aria-label", item.name);
                btn.setAttribute("aria-pressed", String(isActive));

                btn.innerHTML = `
                    <span class="dock-row-icon" aria-hidden="true">${item.svg}</span>
                    <span class="dock-row-text">
                        <span class="dock-row-label">${item.name}</span>
                        <span class="dock-row-sub">
                            <span class="dock-row-crate">${item.crate}</span>
                            <span class="dock-row-flavor">${item.sub}</span>
                        </span>
                    </span>
                    <span class="dock-row-switch" aria-hidden="true"><i></i></span>
                `;

                btn.addEventListener("click", () => {
                    if (isCondiments) {
                        condimentsState[item.key] = !condimentsState[item.key];
                    } else {
                        activeBeverage = item.key;
                        // Every driver proves the same Cargo.toml boundary.
                        currentActiveFile = "cargo";
                    }
                    renderAll();
                });

                // Reading a row swaps its doc-comment into the dock footer.
                btn.addEventListener("mouseenter", () => renderDockFoot(item));
                btn.addEventListener("mouseleave", () => renderDockFoot(null));
                btn.addEventListener("focus", () => renderDockFoot(item));
                btn.addEventListener("blur", () => renderDockFoot(null));

                dockButtonsGroup.appendChild(btn);
            });

            renderDockFoot(null);
        }

        // Code generation for main.rs or Cargo.toml
        function getCodeContent() {
            const bev = BEVERAGE_DATA[activeBeverage];

            if (currentActiveFile === "cargo") {
                const lines = [
                    {
                        code: '<span class="c"># Cargo.toml — leaf platform-driver resolution</span>',
                        raw: "# Cargo.toml — leaf platform-driver resolution",
                    },
                    { code: "[dependencies]", raw: "[dependencies]" },
                    {
                        code: `bite-gpui = { version = <span class="s">"0.1"</span>, default-features = <span class="k">false</span> }`,
                        raw: 'bite-gpui = { version = "0.1", default-features = false }',
                    },
                    { code: "", raw: "" },
                ];

                // One dependency line per attached side.
                Object.values(CONDIMENT_DATA).forEach((side) => {
                    if (!condimentsState[side.key]) return;
                    lines.push({
                        code: `${side.crate} = { version = <span class="s">"0.1"</span> }`,
                        raw: `${side.crate} = { version = "0.1" }`,
                        condiment: side.key,
                        tag: side.pill,
                    });
                });

                lines.push({ code: "", raw: "" });
                lines.push({
                    code: `<span class="c"># Beverage Driver: ${bev.beverage} (${bev.name})</span>`,
                    raw: `# Beverage Driver: ${bev.beverage} (${bev.name})`,
                });
                lines.push({
                    code: `<span class="t">[${bev.cargoTarget}]</span>`,
                    raw: `[${bev.cargoTarget}]`,
                    condiment: bev.key,
                    tag: bev.tag,
                });
                lines.push({
                    code: `${bev.crate} = { version = <span class="s">"0.1"</span> }`,
                    raw: `${bev.crate} = { version = "0.1" }`,
                    condiment: bev.key,
                });

                lines.push({ code: "", raw: "" });
                lines.push({
                    code: '<span class="c"># Modifying UI views invalidates 0 platform driver crates.</span>',
                    raw: "# Modifying UI views invalidates 0 platform driver crates.",
                });

                return lines;
            }

            return mainRsLines(bev);
        }

        // main.rs — one program for every native driver: switching the target never
        // reaches into the view code. wasm32 is the single exception, because it
        // owns the entry point.
        function mainRsLines(bev) {
            const isWasm = activeBeverage === "wasm";
            const lines = [];
            lines.push({
                code: '<span class="k">use</span> gpui::<span class="m">*</span>;',
                raw: "use gpui::*;",
            });

            // wasm32 is the one driver that reaches into the entry point.
            if (isWasm) {
                lines.push({
                    code: '<span class="k">use</span> wasm_bindgen::prelude::<span class="m">*</span>;',
                    raw: "use wasm_bindgen::prelude::*;",
                    condiment: "wasm",
                    tag: bev.tag,
                });
            }

            if (condimentsState.parley) {
                lines.push({
                    code: '<span class="k">use</span> gpui_parley::<span class="t">ParleyTextSystem</span>;',
                    raw: "use gpui_parley::ParleyTextSystem;",
                    condiment: "parley",
                    tag: CONDIMENT_DATA.parley.pill,
                });
            }

            if (condimentsState.surface) {
                lines.push({
                    code: '<span class="k">use</span> gpui_wgpu_surface::<span class="t">WgpuSurface</span>;',
                    raw: "use gpui_wgpu_surface::WgpuSurface;",
                    condiment: "surface",
                    tag: CONDIMENT_DATA.surface.pill,
                });
            }

            lines.push({ code: "", raw: "" });

            if (isWasm) {
                lines.push({
                    code: '<span class="c">#[wasm_bindgen(start)]</span>',
                    raw: "#[wasm_bindgen(start)]",
                });
            }
            lines.push({
                code: isWasm
                    ? '<span class="k">pub fn</span> <span class="f">main</span>() -&gt; <span class="t">Result</span>&lt;(), <span class="t">JsValue</span>&gt; {'
                    : '<span class="k">fn</span> <span class="f">main</span>() {',
                raw: isWasm
                    ? "pub fn main() -> Result<(), JsValue> {"
                    : "fn main() {",
            });
            lines.push({
                code: isWasm
                    ? '    <span class="k">let</span> app = <span class="f">embedded</span>(); <span class="c">// wasm32: the JS host owns the frame clock</span>'
                    : '    <span class="k">let mut</span> app = <span class="f">application</span>(); <span class="c">// Platform SPI resolved from Cargo.toml</span>',
                raw: isWasm
                    ? "    let app = embedded(); // wasm32: the JS host owns the frame clock"
                    : "    let mut app = application(); // Platform SPI resolved from Cargo.toml",
            });

            if (condimentsState.parley) {
                lines.push({
                    code: '    app.<span class="f">with_text_system</span>(<span class="t">Arc</span>::<span class="f">new</span>(<span class="t">ParleyTextSystem</span>::<span class="f">new</span>()));',
                    raw: "    app.with_text_system(Arc::new(ParleyTextSystem::new()));",
                    condiment: "parley",
                    tag: CONDIMENT_DATA.parley.pill,
                });
            }

            if (condimentsState.pacing) {
                lines.push({
                    code: '    app.<span class="f">with_frame_pipeline</span>(<span class="t">ImmediatePipeline</span>::<span class="f">max_fps</span>(<span class="s">60</span>));',
                    raw: "    app.with_frame_pipeline(ImmediatePipeline::max_fps(60));",
                    condiment: "pacing",
                    tag: CONDIMENT_DATA.pacing.pill,
                });
            }

            if (condimentsState.surface) {
                lines.push({
                    code: '    app.<span class="f">with_surface_pipeline</span>(<span class="t">WgpuSurface</span>::<span class="f">new</span>(device, queue));',
                    raw: "    app.with_surface_pipeline(WgpuSurface::new(device, queue));",
                    condiment: "surface",
                    tag: CONDIMENT_DATA.surface.pill,
                });
            }

            if (condimentsState.profiler) {
                lines.push({
                    code: '    app.<span class="f">with_telemetry</span>(<span class="t">TelemetryLayer</span>::<span class="f">realtime</span>());',
                    raw: "    app.with_telemetry(TelemetryLayer::realtime());",
                    condiment: "profiler",
                    tag: CONDIMENT_DATA.profiler.pill,
                });
            }

            lines.push({
                code: '    app.<span class="f">run</span>(|<span class="m">cx</span>: <span class="m">&amp;mut</span> <span class="t">App</span>| {',
                raw: "    app.run(|cx: &mut App| {",
            });
            lines.push({
                code: '        cx.<span class="f">open_window</span>(<span class="t">WindowOptions</span>::<span class="f">default</span>(), |<span class="m">cx</span>| cx.<span class="f">new</span>(|_| <span class="t">MyView</span>)).<span class="f">unwrap</span>();',
                raw: "        cx.open_window(WindowOptions::default(), |cx| cx.new(|_| MyView)).unwrap();",
            });
            lines.push({
                code: isWasm
                    ? '    }) <span class="c">// hand the run handle back to the wasm binding</span>'
                    : "    });",
                raw: isWasm
                    ? "    }) // hand the run handle back to the wasm binding"
                    : "    });",
            });
            lines.push({ code: "}", raw: "}" });

            return lines;
        }

        let currentRawClipboard = "";

        function renderTerminal() {
            if (!codeList) return;

            const bev = BEVERAGE_DATA[activeBeverage];

            // main.rs is the same for every driver — the point of the stack.
            tabMainFileLabel.textContent = "main.rs";

            tabMainFile.classList.toggle(
                "is-active",
                currentActiveFile === "main",
            );
            tabCargoFile.classList.toggle(
                "is-active",
                currentActiveFile === "cargo",
            );

            const lines = getCodeContent();
            currentRawClipboard = lines.map((l) => l.raw).join("\n");

            codeList.innerHTML = "";
            lines.forEach((item, index) => {
                const li = document.createElement("li");
                li.className = "code-line";

                if (item.condiment) {
                    li.classList.add("is-added");
                    li.dataset.condiment = item.condiment;
                    const itemData =
                        CONDIMENT_DATA[item.condiment] ||
                        BEVERAGE_DATA[item.condiment];
                    const color = itemData
                        ? accentOf(itemData)
                        : "var(--brand)";
                    li.style.setProperty("--line-accent", color);
                }

                const num = document.createElement("span");
                num.className = "code-line-num";
                num.textContent = index + 1;

                const body = document.createElement("span");
                body.className = "code-line-body";
                body.innerHTML = item.code || "&nbsp;";

                li.appendChild(num);
                li.appendChild(body);

                if (item.tag) {
                    const tag = document.createElement("span");
                    tag.className = "code-line-tag";
                    tag.textContent = item.tag;
                    li.appendChild(tag);
                }

                codeList.appendChild(li);
            });

            const activeCondCount =
                Object.values(condimentsState).filter(Boolean).length;
            condimentCountChip.textContent = `${activeCondCount} active`;
            beverageTargetChip.textContent =
                BEVERAGE_DATA[activeBeverage].short;

            if (mobileConfigCount) {
                mobileConfigCount.textContent =
                    currentStage === "condiments"
                        ? `${activeCondCount} of 4`
                        : BEVERAGE_DATA[activeBeverage].short;
            }
            if (mobileCodeCount) {
                const injected = lines.filter((l) => l.condiment).length;
                mobileCodeCount.textContent = `${injected} injected`;
            }

            // The header pill is the live target readout.
            if (orderBadge) {
                if (orderBadgeText)
                    orderBadgeText.textContent =
                        BEVERAGE_DATA[activeBeverage].beverage;
                orderBadge.dataset.nonzero = "true";
            }

            // A detached side dims its reading rather than wearing a colour, so
            // the footer stays a status line instead of a traffic light.
            const reading = (el, value, attached) => {
                if (!el) return;
                el.textContent = value;
                el.classList.toggle("is-off", !attached);
            };
            reading(
                mGlyph,
                condimentsState.parley ? "2.1 ms" : "835 ms",
                condimentsState.parley,
            );
            reading(
                mLayout,
                condimentsState.parley ? "4.8 ms" : "28.5 ms",
                condimentsState.parley,
            );
            reading(
                mFps,
                condimentsState.pacing ? "60 FPS" : "Uncapped",
                condimentsState.pacing,
            );
            if (mPlatform) mPlatform.textContent = bev.name;
        }

        function setStage(stage) {
            currentStage = stage;
            currentActiveFile = stage === "condiments" ? "main" : "cargo";
            renderAll();
        }

        function renderAll() {
            const onCondiments = currentStage === "condiments";
            stepBtnCondiments.classList.toggle("is-active", onCondiments);
            stepBtnBeverages.classList.toggle("is-active", !onCondiments);
            stepBtnCondiments.setAttribute(
                "aria-selected",
                String(onCondiments),
            );
            stepBtnBeverages.setAttribute(
                "aria-selected",
                String(!onCondiments),
            );

            renderDock();
            renderTerminal();
        }

        // Mobile cockpit: switch between the configure dock and the code inspector.
        function setMobileTab(tab) {
            mobileTab = tab;
            if (comboLayout) comboLayout.dataset.mobileTab = tab;
            mobileTabConfigure?.classList.toggle(
                "is-active",
                tab === "configure",
            );
            mobileTabCode?.classList.toggle("is-active", tab === "code");
            mobileTabConfigure?.setAttribute(
                "aria-pressed",
                String(tab === "configure"),
            );
            mobileTabCode?.setAttribute("aria-pressed", String(tab === "code"));
        }

        mobileTabConfigure?.addEventListener("click", () =>
            setMobileTab("configure"),
        );
        mobileTabCode?.addEventListener("click", () => setMobileTab("code"));

        stepBtnCondiments?.addEventListener("click", () =>
            setStage("condiments"),
        );
        stepBtnBeverages?.addEventListener("click", () =>
            setStage("beverages"),
        );

        // Dual-file tab switching
        tabMainFile?.addEventListener("click", () => {
            currentActiveFile = "main";
            renderTerminal();
        });
        tabCargoFile?.addEventListener("click", () => {
            currentActiveFile = "cargo";
            renderTerminal();
        });

        copyBtn?.addEventListener("click", () => {
            const file =
                currentActiveFile === "cargo"
                    ? "Cargo.toml"
                    : "the generated Rust";
            window.copyToClipboard(currentRawClipboard, `Copied ${file}`);
        });

        setMobileTab("configure");
        renderAll();

        // The accent hues above are data, so a theme flip has to re-render the
        // dock and code lines rather than being handled in CSS.
        document.addEventListener("bite:themechange", () => renderAll());
    })();
</script>
