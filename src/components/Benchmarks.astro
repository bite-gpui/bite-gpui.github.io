<!-- ACT IV: BENCHMARKS & ITEM RECEIPT -->
<section class="bench-wrapper" id="benchmarks">
  <div class="container">
    <div class="section-head">
      <span class="kicker">Benchmarks · Reproducible data</span>
      <h2>Measured, not promised.</h2>
      <p>
        Every bar below maps directly to an executable benchmark in the
        repository. Tested on real hardware — an Intel i7-8750H laptop running{" "}
        <span class="mono">rustc 1.98.1</span> under normal background desktop
        load (no synthetic CPU pinning). Clone{" "}
        <a
          href="https://github.com/bite-gpui/gpui_parley"
          target="_blank"
          rel="noreferrer"
        >
          <span class="mono">bite-gpui/gpui_parley</span>
        </a>
        , run the commands, and verify the timings yourself.
      </p>
    </div>
    <div class="bench-grid">
      <div class="bench-card">
        <div class="bench-metric">
          <div class="metric-header">
            <span class="metric-title">Raster size lattice</span>
            <span class="metric-sub">
              3.3 ms &rarr; 41.1 µs per frame &middot;{" "}
              <strong>80&times; faster</strong>
            </span>
          </div>
          <div class="bar-track">
            <div class="bar-fill before"></div>
          </div>
          <div class="bar-track">
            <div class="bar-fill after" style="--w-target: 1.2%;"></div>
          </div>
          <p class="metric-note">
            <strong>The problem:</strong> transforming font size dynamically on
            30 lines per frame constantly thrashes standard glyph atlases.
          </p>
          <p class="metric-note">
            <strong>The fix:</strong> rounding raster sizes to a deterministic
            lattice drops atlas cache misses from 154 a frame to zero, shrinking
            the atlas footprint from 32,508 entries down to 644.
          </p>
          <p class="metric-note">
            <strong>Verify:</strong>&nbsp;
            <span class="cmd">$ cargo run --release --example raster_cost</span>
          </p>
        </div>

        <div class="bench-metric">
          <div class="metric-header">
            <span class="metric-title">Glyph hinting cache</span>
            <span class="metric-sub">
              3,480 &rarr; 30 instances per frame &middot;{" "}
              <strong>116&times; fewer</strong>
            </span>
          </div>
          <div class="bar-track">
            <div class="bar-fill before"></div>
          </div>
          <div class="bar-track">
            <div class="bar-fill after" style="--w-target: 0.9%;"></div>
          </div>
          <p class="metric-note">
            <strong>The problem:</strong> upstream GPUI runs a face's bytecode
            hinting program per glyph instance (~31 µs each).
          </p>
          <p class="metric-note">
            <strong>The fix:</strong> keying the cache directly to (face, size)
            builds just 30 instances per frame where an uncached hinting run
            would execute 3,480 times.
          </p>
          <p class="metric-note">
            <strong>Verify:</strong>&nbsp;
            <span class="cmd">$ cargo run --release --example raster_cost</span>
          </p>
        </div>

        <div class="bench-metric">
          <div class="metric-header">
            <span class="metric-title">Text as vector geometry</span>
            <span class="metric-sub">
              26.7 ms &rarr; 0.69 ms per screenful &middot;{" "}
              <strong>39&times; CPU reduction</strong>
            </span>
          </div>
          <div class="bar-track">
            <div class="bar-fill before"></div>
          </div>
          <div class="bar-track">
            <div class="bar-fill after" style="--w-target: 2.6%;"></div>
          </div>
          <p class="metric-note">
            <strong>The problem:</strong> rasterizing dense text on every frame
            devours CPU cycles.
          </p>
          <p class="metric-note">
            <strong>The fix:</strong> outlines are tessellated once (639 µs).
            Subsequent frames stream 218,322 pre-computed vertices straight to
            the GPU in 48 µs. You trade bus traffic for massive frame savings.
          </p>
          <p class="metric-note">
            <strong>Verify:</strong>&nbsp;
            <span class="cmd">$ cargo run --release --example vector_cost</span>
          </p>
        </div>
      </div>

      <!-- The item receipt -->
      <aside class="receipt" aria-label="Performance summary receipt">
        <pre class="receipt-text">========================================
            THE ITEM RECEIPT
  Order #0042 · Tray 6 · Modular GPUI
========================================

Raster lattice (frame)        80× FASTER
Hinting instances            3,480 -> 30
Text as triangles (CPU)       39× FASTER
Outline tessellation (lookup)     3.8 µs
Vertex traffic (frame)           42.6 MB
----------------------------------------
FRAME BUDGET TOTAL
The Vector Route       3.8 ms of 16.7 ms
                     (Well under 60 FPS)
========================================
   VERIFY IN /gpui_parley/benchmarks
========================================</pre>
      </aside>
    </div>
  </div>
</section>

<script>
  (() => {
    const benchIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const fills = entry.target.querySelectorAll(".bar-fill");
          fills.forEach((fill, i) => {
            setTimeout(() => fill.classList.add("is-in"), i * 110);
          });
          benchIO.unobserve(entry.target);
        });
      },
      { threshold: 0.4 },
    );

    document
      .querySelectorAll(".bench-metric")
      .forEach((m) => benchIO.observe(m));
  })();
</script>
