---
import Logo from "./Logo.astro";

// Two modes, both derived from `current` rather than switched at runtime. A
// static site already knows which page it is rendering, so nothing here is
// simulated: the one-pager gets the frontdoor bar, and every sub-page gets a
// trail of where it sits.
//
// The bar reads left to right as one sentence: the mark and its version, then
// where you are and what sits under it, then what else there is, then the install
// line. Pipes separate those groups, and only the middle group changes between
// pages.
const { current = "" } = Astro.props;

const anchors = [
  // `id` is only set on the one link the journey has to intercept; see
  // Journey.astro's scrollToLayers. Its hash matches no element on purpose —
  // the journey already starts at the document top, so that is the fallback,
  // and the script refines it to the unstacked end of the track. `key` is also
  // the id of the section the link points at, which is what the scroll spy below
  // reads.
  { id: "navLayers", href: "/#layers", label: "The Layers", key: "journey" },
  { href: "/#capabilities", label: "Combos", key: "capabilities" },
  { href: "/#benchmarks", label: "The Receipt", key: "benchmarks" },
  { href: "/#quickstart", label: "Express Lane", key: "quickstart" },
];

// Every sub-page, and the page that contains it. `parent` is what the trail names
// after the frontdoor: the two swap guides live under the hub, so their trail
// stops at Swaps rather than at the frontdoor.
const guides = [
  { href: "/swaps", label: "Swaps", key: "swaps" },
  { href: "/parley", label: "Parley", key: "parley", parent: "swaps" },
  { href: "/morphorm", label: "Morphorm", key: "morphorm", parent: "swaps" },
  { href: "/demos", label: "Demos", key: "demos" },
  { href: "/compare", label: "Compare", key: "compare" },
];

const here = guides.find((guide) => guide.key === current);
// The section the page sits in: the hub a swap guide belongs to, or the page
// itself when nothing contains it. It is what the trail names after the
// frontdoor, and its own pages are what the trail then carries — Parley and
// Morphorm are two pages of one section, not two more entries beside it.
const section = here
  ? (guides.find((guide) => guide.key === here.parent) ?? here)
  : undefined;
// The section's pages, the hub itself excluded: the trail names that. Empty for
// /demos and /compare, whose trail is then just the crumb.
const sectionPages = section
  ? guides.filter((guide) => guide.parent === section.key)
  : [];
// What the trail already says. On a section page the bar says nothing else — the
// reader is inside one section and the guides standing beside it are clutter — so
// this set is what decides which of the section's own pages belong to it: Parley
// and Morphorm are pages of Swaps, and /demos and /compare have no business
// listing them.
const carried = new Set(
  section ? [section, ...sectionPages].map((guide) => guide.key) : [],
);
// The sheet's list on a section page: every guide the section can reach, including
// the ones the trail above already names, because the sheet is the only place the
// reader can get to the others from.
const rail = guides.filter((guide) => !guide.parent || carried.has(guide.key));
// What the frontdoor shows: the hub and the two standalone guides. The swap
// guides are one level down, inside the hub, and the frontdoor is not the place
// to flatten that.
const topLevel = guides.filter((guide) => !guide.parent);
---

<nav class={`nav${here ? " is-section" : ""}`} id="nav">
  <div class="nav-inner">
    {/* The brand opens the bar and nothing else sits with it: identity, then a
         pipe, then where you can go. The wordmark and the version chip are the two
         things that step aside on a narrow section bar; the mark never does. */}
    <a
      href={here ? "/#journey" : "#journey"}
      class="logo"
      title={here ? "Back to the frontdoor" : undefined}
    >
      <Logo />
      <span class="logo-word">bite-gpui</span>
      <span class="logo-version">v1.21.0</span>
    </a>

    {section ? (
      /* The way back, in its own pipe-delimited group: it is not the brand and not
           the section, it is the step up. It stays outside the collapsible part of
           the bar, so it is one tap away at every width. */
      <div class="nav-back-group">
        <a class="nav-back" href="/#journey">
          <span aria-hidden="true">←</span>
          <span>Frontdoor</span>
        </a>
      </div>
    ) : null}

    {section ? (
      /* The section you are in and its pages, which is the whole of the bar: the hub
           opens the group, because everything after it is one level inside it, and the
           page itself is not named again, because the group marks it and two current
           markers in one bar is one too many. Everything else the site has is behind
           the breadcrumb, the sheet or the footer. */
      <div class="nav-trail">
        <ul class="nav-trail-links">
          <li>
            <a
              class="nav-section"
              href={section.href}
              aria-current={current === section.key ? "page" : undefined}
            >
              <i class="nav-section-dot" aria-hidden="true" />
              {section.label}
            </a>
          </li>
          {sectionPages.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={current === link.key ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ) : null}

    <!-- Mobile only. The full row needs 1048px of content box and the sheet has
             to take over well before the hero's own 820px breakpoint. -->
    <button
      class="nav-toggle"
      id="navToggle"
      type="button"
      aria-expanded="false"
      aria-controls="navMenu"
      aria-label="Open menu"
    >
      <span class="nav-bars" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
    </button>

    <!-- `display: contents` on desktop, so the links and the CTA join the nav row
             as they always did; a drop-down sheet below the 1180px breakpoint. On a
             section page the list inside it is the sheet's alone: the bar carries the
             reader's own breadcrumb and nothing that stands beside it. -->
    <div class="nav-menu" id="navMenu">
      <ul class={`nav-links${section ? " is-sheet-only" : ""}`}>
        {section ? (
          rail.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={current === link.key ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        ) : (
          <>
            {anchors.map((link) => (
              <li>
                <a
                  id={link.id}
                  href={link.href}
                  data-section={link.key}
                  aria-current={current === link.key ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
            {/* Splits the page's own chapters from the sub-pages. Purely visual,
                  so it is hidden from the accessibility tree and again on the
                  sheet. */}
            <li class="nav-divider" aria-hidden="true" />
            {topLevel.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={current === link.key ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </>
        )}
      </ul>
      <button
        class="btn btn-primary nav-cta"
        id="navInstall"
        type="button"
        data-copy="cargo add bite-gpui"
        aria-label="Copy cargo add bite-gpui"
      >
        <span class="nav-cta-prompt" aria-hidden="true">
          $
        </span>
        <span>cargo add bite-gpui</span>
        <span class="nav-cta-copy" aria-hidden="true">
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="9" y="9" width="12" height="12" rx="2"></rect>
            <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
          </svg>
        </span>
      </button>
    </div>

    <!-- Light/dark switch. A sibling of .nav-menu rather than a child, so it
             stays in the bar beside the hamburger when the bar collapses instead
             of moving into the drop-down sheet. -->
    <button
      class="theme-toggle"
      id="themeToggle"
      type="button"
      aria-label="Switch to light theme"
      title="Switch to light theme"
    >
      <svg
        class="icon-sun"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4.2"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"></path>
      </svg>
      <svg
        class="icon-moon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.8A9 9 0 1 1 11.2 2a7 7 0 0 0 9.8 10.8Z"></path>
      </svg>
    </button>
  </div>
</nav>

<script>
  const nav = document.getElementById("nav");
  const toggle = document.getElementById("navToggle");
  const menu = document.getElementById("navMenu");

  // The frontdoor's four links point into this page's chapters, and a one-pager
  // cannot say "you are here" at build time — so the bar marks the chapter the
  // reader has scrolled into, the same way a sub-page's rail marks its own entry
  // at build time. `location` rather than `page`: the reader is inside one part of
  // a page, not on one page of a set. Empty on a sub-page, where there is nothing
  // left to watch.
  const chapters = [
    ...document.querySelectorAll("#navMenu a[data-section]"),
  ].map((link) => ({
    link,
    section: document.getElementById(link.dataset.section ?? ""),
  }));

  let marked = null;

  // The chapter in view is the last one whose top has passed under the bar. The
  // bar is fixed, so the line to measure against is its own height. The journey
  // is the whole first screen, so its link is the marked one from the top of the
  // page until Combos — which is what that link is for: it is the way into the
  // chapter the reader is already standing in.
  const markChapter = () => {
    if (!chapters.length) return;
    const line = (nav?.offsetHeight ?? 64) + 16;
    let inView = null;
    for (const { link, section } of chapters) {
      if (section && section.getBoundingClientRect().top <= line) inView = link;
    }
    if (inView === marked) return;
    marked?.removeAttribute("aria-current");
    inView?.setAttribute("aria-current", "location");
    marked = inView;
  };

  const onScroll = () => {
    nav?.classList.toggle("is-scrolled", window.scrollY > 12);
    markChapter();
  };

  const setOpen = (open) => {
    nav?.classList.toggle("is-open", open);
    menu?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };

  const isOpen = () => !!nav?.classList.contains("is-open");

  toggle?.addEventListener("click", () => setOpen(!isOpen()));

  // Any link tap closes the sheet, whether it scrolls to an anchor underneath
  // the sheet or navigates to a sub-page.
  menu
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", () => setOpen(false)));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen()) {
      setOpen(false);
      toggle?.focus();
    }
  });

  // Tapping anywhere off the sheet closes it.
  document.addEventListener("click", (event) => {
    if (isOpen() && nav && !nav.contains(event.target)) setOpen(false);
  });

  // Resizing past the breakpoint would otherwise leave the desktop row hidden.
  // Kept in step with the `max-width: 1180px` query in global.css that collapses
  // the bar — the frontdoor row is the wider of the two modes and needs 1048px of
  // the 1152px content box to keep its seven links on one line.
  window.addEventListener("resize", () => {
    if (window.innerWidth > 1180) setOpen(false);
  });

  // The nav CTA copies the install line rather than jumping: the sheet already
  // carries Express Lane for navigation, and the command is what a reader wants
  // from a bar that is on screen the whole way down the page. It closes the
  // sheet itself, since only the anchors above are wired to do that.
  const installBtn = document.getElementById("navInstall");
  installBtn?.addEventListener("click", () => {
    window.copyToClipboard(
      installBtn.dataset.copy,
      `Copied ${installBtn.dataset.copy}`,
    );
    setOpen(false);
  });

  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // The chapters shift as fonts land and the hero re-measures, and neither fires
  // a scroll — so re-mark once the page has settled.
  window.addEventListener("load", markChapter);

  // Colour scheme switch. The attribute is already set pre-paint; this only
  // wires the button, keeps its label honest, and syncs the browser-chrome
  // meta tag through window.applyTheme (Layout).
  const themeToggle = document.getElementById("themeToggle");
  const currentTheme = () =>
    document.documentElement.dataset.theme === "light" ? "light" : "dark";

  const syncThemeToggle = () => {
    const label =
      currentTheme() === "light"
        ? "Switch to dark theme"
        : "Switch to light theme";
    themeToggle?.setAttribute("aria-label", label);
    themeToggle?.setAttribute("title", label);
  };

  themeToggle?.addEventListener("click", () => {
    window.applyTheme(currentTheme() === "light" ? "dark" : "light");
    syncThemeToggle();
  });

  // applyTheme fires before this script only via the head bootstrap, which sets
  // the attribute without the meta sync — so sync the chrome once here.
  window.applyTheme?.(currentTheme(), false);
  syncThemeToggle();
</script>
