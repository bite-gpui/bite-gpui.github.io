---
import Logo from "./Logo.astro";
---

<nav class="nav" id="nav">
  <div class="nav-inner">
    <a href="#journey" class="logo">
      <Logo />
      <span>bite-gpui</span>
      <span class="logo-version">v1.21.0</span>
    </a>

    <!-- Mobile only. The full row of links plus the CTA needs ~772px, so it
             overflows well before the hero's own 820px breakpoint. -->
    <button
      class="nav-toggle"
      id="navToggle"
      type="button"
      aria-expanded="false"
      aria-controls="navMenu"
      aria-label="Open menu"
    >
      <span class="nav-bars" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
    </button>

    <!-- `display: contents` on desktop, so the links and the CTA join the
             nav row as they always did; a drop-down sheet at ≤820px. -->
    <div class="nav-menu" id="navMenu">
      <ul class="nav-links">
        <li>
          <a href="#journey">The Kitchen</a>
        </li>
        <li>
          <a href="#capabilities">Studio</a>
        </li>
        <li>
          <a href="#benchmarks">Benchmarks</a>
        </li>
        <li>
          <a href="#quickstart">Quickstart</a>
        </li>
      </ul>
      <a class="btn btn-primary nav-cta" href="#quickstart">
        cargo add bite-gpui
      </a>
    </div>

    <!-- Light/dark switch. A sibling of .nav-menu rather than a child, so it
             stays in the bar beside the hamburger at ≤820px instead of moving
             into the drop-down sheet. -->
    <button
      class="theme-toggle"
      id="themeToggle"
      type="button"
      aria-label="Switch to light theme"
      title="Switch to light theme"
    >
      <svg
        class="icon-sun"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4.2"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"></path>
      </svg>
      <svg
        class="icon-moon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.8A9 9 0 1 1 11.2 2a7 7 0 0 0 9.8 10.8Z"></path>
      </svg>
    </button>
  </div>
</nav>

<script>
  const nav = document.getElementById("nav");
  const toggle = document.getElementById("navToggle");
  const menu = document.getElementById("navMenu");

  const onScroll = () =>
    nav?.classList.toggle("is-scrolled", window.scrollY > 12);

  const setOpen = (open) => {
    nav?.classList.toggle("is-open", open);
    menu?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };

  const isOpen = () => !!nav?.classList.contains("is-open");

  toggle?.addEventListener("click", () => setOpen(!isOpen()));

  // Any link tap closes the sheet, whether or not it navigates (all four are
  // same-page anchors, so the scroll happens underneath it).
  menu
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", () => setOpen(false)));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen()) {
      setOpen(false);
      toggle?.focus();
    }
  });

  // Tapping anywhere off the sheet closes it.
  document.addEventListener("click", (event) => {
    if (isOpen() && nav && !nav.contains(event.target)) setOpen(false);
  });

  // Resizing past the breakpoint would otherwise leave the desktop row hidden.
  window.addEventListener("resize", () => {
    if (window.innerWidth > 820) setOpen(false);
  });

  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Colour scheme switch. The attribute is already set pre-paint; this only
  // wires the button, keeps its label honest, and syncs the browser-chrome
  // meta tag through window.applyTheme (Layout).
  const themeToggle = document.getElementById("themeToggle");
  const currentTheme = () =>
    document.documentElement.dataset.theme === "light" ? "light" : "dark";

  const syncThemeToggle = () => {
    const label =
      currentTheme() === "light"
        ? "Switch to dark theme"
        : "Switch to light theme";
    themeToggle?.setAttribute("aria-label", label);
    themeToggle?.setAttribute("title", label);
  };

  themeToggle?.addEventListener("click", () => {
    window.applyTheme(currentTheme() === "light" ? "dark" : "light");
    syncThemeToggle();
  });

  // applyTheme fires before this script only via the head bootstrap, which sets
  // the attribute without the meta sync — so sync the chrome once here.
  window.applyTheme?.(currentTheme(), false);
  syncThemeToggle();
</script>
