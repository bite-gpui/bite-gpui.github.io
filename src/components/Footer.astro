---
import Logo from "./Logo.astro";
---

<footer>
    <div class="container">
        <div class="foot-grid">
            <div class="foot-brand">
                <a href="#" class="logo">
                    <Logo />
                    <span>bite-gpui</span>
                </a>
                <p>
                    A modular re-architecture of GPUI. Dual-licensed under MIT
                    or Apache-2.0.
                </p>
            </div>

            <div class="foot-col">
                <h4>Architecture</h4>
                <ul>
                    <li>
                        <a href="#journey">Crate Hierarchy</a>
                    </li>
                    <li>
                        <a href="#capabilities">Combo Studio</a>
                    </li>
                    <li>
                        <a href="#capabilities">Platform Drivers</a>
                    </li>
                    <li>
                        <a href="#benchmarks">Benchmarks</a>
                    </li>
                </ul>
            </div>

            <div class="foot-col">
                <h4>Crates</h4>
                <ul>
                    <li>
                        <a href="#journey">crates/gpui</a>
                    </li>
                    <li>
                        <a href="#journey">gpui_runtime</a>
                    </li>
                    <li>
                        <a href="#journey">gpui_authoring</a>
                    </li>
                    <li>
                        <a href="#journey">gpui_engine</a>
                    </li>
                    <li>
                        <a href="#journey">gpui_platform</a>
                    </li>
                </ul>
            </div>

            <div class="foot-col">
                <h4>Community</h4>
                <ul>
                    <li>
                        <a
                            href="https://github.com"
                            target="_blank"
                            rel="noreferrer"
                        >
                            GitHub Repository
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://crates.io"
                            target="_blank"
                            rel="noreferrer"
                        >
                            crates.io
                        </a>
                    </li>
                    <li>
                        <a href="#">Architectural RFC</a>
                    </li>
                    <li>
                        <a href="#">Discord Server</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="foot-bottom">
            <span>
                Dual licensed under Apache-2.0 and MIT. Built for the Rust UI
                ecosystem.
            </span>
            <span>Not affiliated with upstream GPUI or Zed Industries.</span>
        </div>
    </div>
</footer>
