            </a>
          </li>
          <li>
            <a
              href="https://crates.io/crates/bite-gp-parley"
              target="_blank"
              rel="noreferrer"
            >
              bite-gp-parley
            </a>
          </li>
          <li>
            <a
              href="https://crates.io/crates/bite-gp-morphorm"
              target="_blank"
              rel="noreferrer"
            >
              bite-gp-morphorm
            </a>
          </li>
          <li>
            <a
              href="https://github.com/bite-gpui/distribution"
              target="_blank"
              rel="noreferrer"
            >
              Distribution &amp; Design
            </a>
          </li>
        </ul>
