          <li>
            <a href="/#journey">bite-gpui</a>
          </li>
          <li>
            <a href="/#journey">bite-gp-runtime</a>
          </li>
          <li>
            <a href="/#journey">bite-gp-authoring</a>
          </li>
          <li>
            <a href="/#journey">bite-gp-engine</a>
          </li>
          <li>
            <a href="/#journey">bite-gp-platform</a>
          </li>
        </ul>
      </div>

      <div class="foot-col">
        <h4>Community</h4>
        <ul>
          <li>
            <a
              href="https://github.com/bite-gpui/bite-gpui"
              target="_blank"
              rel="noreferrer"
            >
              GitHub Repository
            </a>
          </li>
          <li>
            <a
              href="https://crates.io/crates/bite-gpui"
              target="_blank"
              rel="noreferrer"
            >
