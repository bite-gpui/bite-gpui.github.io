---
import Logo from "./Logo.astro";
---

<footer>
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href="/#journey" class="logo">
          <Logo />
          <span>bite-gpui</span>
        </a>
        <p>A modular re-architecture of GPUI. Licensed under Apache-2.0.</p>
      </div>

      <div class="foot-col">
        <h4>Architecture</h4>
        <ul>
          <li>
            <a href="/#journey">Crate Hierarchy</a>
          </li>
          <li>
            <a href="/#capabilities">Combo Studio</a>
          </li>
          <li>
            <a href="/#benchmarks">The Receipt</a>
          </li>
          <li>
            <a href="/#quickstart">Express Lane</a>
          </li>
        </ul>
      </div>

      <div class="foot-col">
        <h4>Guides</h4>
        <ul>
          <li>
            <a href="/parley">Using gpui_parley</a>
          </li>
          <li>
            <a href="/morphorm">Using gpui_morphorm</a>
          </li>
          <li>
            <a href="/demos">Demos</a>
          </li>
          <li>
            <a href="/compare">Compare</a>
          </li>
        </ul>
