---
import Page from "../layouts/Page.astro";
import CodeTabs from "../components/CodeTabs.astro";
import { ways } from "../data/ways";

// The hub for the four ways to extend — the page the nav calls "Ways to extend".
// It was two pages, swaps and wraps, until they were merged: a reader deciding
// how to extend the engine is asking a single question, and the ways are the
// answers to it. `wrap` and `swap` are the two the project's architecture
// documents as tiers; `shove` (surfaces) and `serve` (platforms) are the other
// two, and each has a guide of its own.
//
// The seam inventory is read out of the published crates rather than from a
// diagram: every trait below is declared in a `bite-gp-*` layer crate, every
// hook is a real method on `Application`, and every default is the type the
// facade installs when you say nothing. The two swaps are published from their
// own repositories; the third algorithm seam, the scene renderer, has no hook to
// install one through, and this page says so instead of implying otherwise.
//
// Where each fact comes from (crates.io 1.25.x sources):
//   trait           crate               hook                        default
//   TextSystem      bite-gp-engine      with_text_system            DefaultTextSystem
//   LayoutEngine    bite-gp-engine      with_layout_engine          TaffyLayoutEngine
//   FramePipeline   bite-gp-authoring   with_frame_pipeline         StandardImmediatePipeline
//   Platform        bite-gp-platform    with_platform               one per host, by cfg
//   SceneRenderer   bite-gp-engine      — none —                    one per backend, by cfg
//
// The wrap tier is the second half: bite-gp-pass depends on `bite-gp-authoring`
// and nothing else at runtime, and the two in-tree decorators are
// `gpui_runtime`'s, documented below beside the trait they decorate.

const stats = [
  {
    value: "5",
    label: "Trait boundaries",
    note: "Exposed at the facade",
  },
  {
    value: "2",
    label: "Ready to swap",
    note: "Live on crates.io",
    win: true,
  },
  {
    value: "1",
    label: "Ready to wrap",
    note: "bite-gp-pass 1.21.3",
    win: true,
  },
  {
    value: "0",
    label: "Engine forks",
    note: "Maintained across all",
  },
];

const seams = [
  {
    trait: "TextSystem",
    owns: "Text shaping, line layout, and glyph rasterization.",
    hook: "Application::with_text_system(Arc<dyn TextSystem>)",
    call: "ParleyTextSystem::new()",
    defined: "gpui_engine",
    default: "DefaultTextSystem",
    defaultNote: "over the host's own text backend",
    swap: "bite-gp-parley",
    swapType: "ParleyTextSystem",
    swapVersion: "1.21.1",
    measured: "2.4× faster wrap",
    link: "/parley",
    linkLabel: "Using gpui_parley",
    published: true,
  },
  {
    trait: "LayoutEngine",
    owns: "Translating the reactive element tree into positioned layout boxes.",
    hook: "Application::with_layout_engine(impl Fn() -> Box<dyn LayoutEngine>)",
    call: "|| Box::new(MorphormLayoutEngine::new())",
    defined: "gpui_engine",
    default: "TaffyLayoutEngine",
    defaultNote: "the engine the facade bundles",
    swap: "bite-gp-morphorm",
    swapType: "MorphormLayoutEngine",
    swapVersion: "1.21.2",
    measured: "3.4–3.8× cheaper",
    link: "/morphorm",
    linkLabel: "Using gpui_morphorm",
    published: true,
  },
  {
    trait: "FramePipeline",
    owns: "Pacing, presentation order, and render instrumentation.",
    hook: "Application::with_frame_pipeline(impl Fn(WindowId) -> Box<dyn FramePipeline>)",
    // Not stock: the shipped default carries `.max_fps(n)` and `.instrumented(metrics)`
    // as decorators, and the one-pager's governor is that default configured.
    staticCall: true,
    call: "StandardImmediatePipeline.max_fps(60)",
    defined: "gpui_authoring",
    default: "StandardImmediatePipeline",
    defaultNote:
      "and its shipped decorators: .max_fps(n) and .instrumented(metrics)",
    swap: null,
    note: "The frame governor the one-pager shows is configuration of this default — ThrottledPipeline and InstrumentedPipeline, both in gpui_runtime — rather than a second implementation. Nothing out of tree publishes one. It is also the one seam a wrap can plug into.",
    link: "/demos",
    linkLabel: "The open seams",
    published: false,
  },
  {
    trait: "Platform",
    owns: "OS event loop, display handles, clipboard, and input routing.",
    hook: "Application::with_platform(Rc<dyn Platform>)",
    defined: "gpui_platform",
    default: "one per host",
    defaultNote:
      "LinuxPlatform over X11 or Wayland, MacPlatform, WindowsPlatform, WebPlatform — compiled in by cfg, never by a manifest line",
    swap: null,
    note: "The hook is the constructor, so a platform is chosen with the application rather than chained onto it.",
    link: "/demos",
    linkLabel: "The open seams",
    published: false,
  },
  {
    trait: "SceneRenderer",
    owns: "Lowering the scene intermediate representation (IR) into GPU drawing commands.",
    hook: null,
    defined: "gpui_engine",
    default: "one per backend",
    defaultNote:
      "MetalRenderer, DirectXRenderer, WgpuRenderer on Linux, and a headless one the test harness draws through",
    swap: null,
    note: "No Application setter installs one today: the trait is the boundary, and the platform picks the implementation. A second one needs a door before it can be a crate.",
    link: "/demos",
    linkLabel: "The open seams",
    published: false,
  },
];

// The shelf keeps the three algorithm seams. FramePipeline is the wrap's seam and
// Platform is the host's, and the two sections further down carry them.
const swapped = seams.filter(
  (seam) => seam.trait !== "FramePipeline" && seam.trait !== "Platform",
);

// The wraps. One is published from its own repository; two ship inside the
// facade. All three implement FramePipeline, and all three forward the passes
// they do not change.
const wraps: {
  name: string;
  badge: string;
  lib: string;
  does: string;
  facts: string[];
  link?: string;
  linkLabel?: string;
}[] = [
  {
    name: "bite-gp-pass",
    badge: "Published",
    lib: "gpui_pass",
    does: "Reads the frame's passes and the asks that did not draw: a policy-driven rate on one side, a ledger of what each pass cost on the other. A decorator you install without changing a view.",
    facts: [
      "a rate and a ledger",
      "one runtime dependency",
      "exercisable in CI",
    ],
    link: "/pass",
    linkLabel: "Using gpui_pass",
  },
  {
    name: "ThrottledPipeline",
    badge: "In the facade",
    lib: "gpui_runtime",
    does: "The facade's own rate cap: draw every Nth ask, decided from one number and the last frame.",
    facts: ["caps a rate", "whole intervals only"],
  },
  {
    name: "InstrumentedPipeline",
    badge: "In the facade",
    lib: "gpui_runtime",
    does: "The facade's own accounting: an Instant around each root pass, summed into running phase totals.",
    facts: ["running totals", "drawn frames only"],
  },
];

const open = [
  {
    seam: "FramePipeline",
    take: "An out-of-tree pipeline. The shipped decorators are the pattern: a decorator forwards the passes it does not change and decides the ones it does, so a third-party one would wrap or replace StandardImmediatePipeline at the same hook.",
    project: "pipeline-decorator",
  },
  {
    seam: "Platform",
    take: "A platform that needs no display, so a CI job can render. The built-in route is the facade with its platform bundle dropped — default-features = false — plus the TestPlatform the test harness already runs on.",
    project: "headless-platform",
  },
  {
    seam: "SceneRenderer",
    take: "A renderer out of tree, which is what a raw render-pass blit would actually have to be — and a door at the facade first, because there is no setter to install one through.",
    project: "scene-renderer",
  },
];

const cargo = `<span class="c"># both published swaps, one manifest</span>
[<span class="t">dependencies</span>]
bite-gpui = <span class="s">"1.25"</span>
bite-gp-parley = <span class="s">"1.21"</span>
bite-gp-morphorm = <span class="s">"1.21"</span>`;

const main = `<span class="k">use</span> gpui::*;
<span class="k">use</span> gpui_morphorm::<span class="t">MorphormLayoutEngine</span>;
<span class="k">use</span> gpui_parley::<span class="t">ParleyTextSystem</span>;

<span class="k">fn</span> <span class="f">main</span>() {
    <span class="f">application</span>()
        .<span class="f">with_text_system</span>(<span class="t">ParleyTextSystem</span>::<span class="f">new</span>())
        .<span class="f">with_layout_engine</span>(|| <span class="t">Box</span>::<span class="f">new</span>(<span class="t">MorphormLayoutEngine</span>::<span class="f">new</span>()))
        .<span class="f">run</span>(|cx: &amp;<span class="k">mut</span> <span class="t">App</span>| { <span class="c">/* the same div() tree */</span> });
}`;

const artifacts = [
  {
    name: "bite-gp-parley",
    desc: "The second TextSystem. Published, with its own tests and cost examples.",
    href: "https://crates.io/crates/bite-gp-parley",
  },
  {
    name: "bite-gp-morphorm",
    desc: "The second LayoutEngine, and the conformance test that compares it to the default.",
    href: "https://crates.io/crates/bite-gp-morphorm",
  },
  {
    name: "bite-gp-pass",
    desc: "The first wrap: a rate policy and a per-frame ledger behind the frame pipeline.",
    href: "https://crates.io/crates/bite-gp-pass",
  },
  {
    name: "gpui_interop",
    desc: "The surface bridge: dma-buf and shared-texture producers, published from its own repository.",
    href: "https://crates.io/crates/gpui_interop",
  },
  {
    name: "bite-gpui/gpui_parley",
    desc: "The repository the text engine is developed and released from.",
    href: "https://github.com/bite-gpui/gpui_parley",
  },
  {
    name: "bite-gpui/gpui_morphorm",
    desc: "The repository the layout solver is developed and released from.",
    href: "https://github.com/bite-gpui/gpui_morphorm",
  },
  {
    name: "bite-gpui/gpui_pass",
    desc: "The repository the frame-pipeline wrap is developed and released from.",
    href: "https://github.com/bite-gpui/gpui_pass",
  },
  {
    name: "bite-gpui/gpui_interop",
    desc: "The repository the surface bridge is developed and released from.",
    href: "https://github.com/bite-gpui/gpui_interop",
  },
];
---

<Page
  title="Ways to extend — bite-gpui"
  description="Four ways to extend the engine without a fork: swap a seam, wrap the frame pipeline, shove your own surface in, or serve it from a platform of your own — with the published crates and what each open seam would take."
  kicker="Architecture · Ways to extend"
  heading="Wrap it, swap it,"
  accent="shove it in, serve it."
  lede="Why maintain an engine fork? Replace the text shaper or the layout solver, decorate the frame pipeline, composite pixels GPUI did not draw, or bring the platform itself. Four ways to change the engine, and not one of them edits a div()."
  current="swaps"
  stats={stats}
>
  <section>
    <div class="section-head">
      <span class="kicker">Four ways</span>
      <h2>Wrap it, swap it, shove it in, serve it.</h2>
      <p>
        The distinction is not stylistic: it decides what you hand over, which
        boundary it plugs into, and what publishing it commits the project to.
        Everything below is one of the four.
      </p>
    </div>

    <div class="card-grid four">
      {ways.map((way) => (
        <article class={`card way ${way.accent}`}>
          <span class="way-n">{way.n}</span>
          <div class="card-head">
            <h3 class="card-title">{way.name}</h3>
            <span class="card-badge">{way.badge}</span>
          </div>
          <p>{way.does}</p>
          <ul class="card-facts">
            {way.facts.map((fact) => (
              <li>{fact}</li>
            ))}
          </ul>
          <a class="card-link" href={way.href}>
            {way.linkLabel} →
          </a>
        </article>
      ))}
    </div>
  </section>

  <section id="swap">
    <div class="section-head">
      <span class="kicker">Swap · The shelf</span>
      <h2>What you can swap out.</h2>
      <p>
        Every swappable boundary is defined in a standalone layer crate, backed
        by a default implementation, and re-exported under
        <span class="mono">use gpui::*</span>. Two have a published second
        implementation; the third — the scene renderer — has no hook to install
        one through, and this page says so rather than implying otherwise.
      </p>
    </div>

    <div class="seam-grid">
      {swapped.map((seam) => (
        <article class={`seam${seam.published ? " is-published" : ""}`}>
          <div class="seam-head">
            <span class="seam-trait">{seam.trait}</span>
            {seam.published ? (
              <span class="pill win">published</span>
            ) : (
              <span class="pill flat">open</span>
            )}
          </div>

          <p class="seam-role">{seam.owns}</p>

          <div class={`seam-wire${seam.hook ? "" : " is-none"}`}>
            <span class="seam-wire-label">hook at the facade</span>
            <code>{seam.hook ?? "none — the trait is the boundary"}</code>
          </div>

          {seam.call ? (
            <button
              class="seam-call"
              type="button"
              data-copy={seam.call}
              aria-label={`Copy ${seam.call}`}
            >
              <code>
                {/* `staticCall` is the one that is not a stock call: it is the
                       shipped default with a decorator applied, which is what the
                       note under the card explains. */}
                {seam.staticCall ? "app." : "app."}
                <span class="seam-call-method">
                  {seam.trait === "TextSystem"
                    ? "with_text_system"
                    : seam.trait === "LayoutEngine"
                      ? "with_layout_engine"
                      : "with_frame_pipeline"}
                </span>
                ( {seam.call}){seam.staticCall ? ";" : ";"}
              </code>
              <span class="seam-call-copy" aria-hidden="true">
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="9" y="9" width="12" height="12" rx="2"></rect>
                  <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
                </svg>
              </span>
            </button>
          ) : null}

          <dl class="seam-facts">
            <dt>defined in</dt>
            <dd>
              <strong>{seam.defined}</strong>
            </dd>
            <dt>default</dt>
            <dd>
              <strong>{seam.default}</strong>
              <br />
              {seam.defaultNote}
            </dd>
            <dt>second implementation</dt>
            <dd>
              {seam.swap ? (
                <>
                  <strong>{seam.swap}</strong> · {seam.swapType} ·{" "}
                  {seam.swapVersion}
                </>
              ) : (
                <span>none published</span>
              )}
            </dd>
          </dl>

          {seam.note ? <p class="seam-role">{seam.note}</p> : null}

          <a class="seam-link" href={seam.link}>
            {seam.linkLabel} →
          </a>
        </article>
      ))}
    </div>
  </section>

  <section id="wrap">
    <div class="section-head">
      <span class="kicker">Wrap · The inventory</span>
      <h2>Decorate the pipeline.</h2>
      <p>
        One wrap is published from its own repository; two ship inside the
        facade as decorators you can stack without depending on anything. All
        three implement the same trait, and all three forward the passes they do
        not change.
      </p>
      <p>
        The seam is <span class="mono">FramePipeline</span>, declared in
        <span class="mono">gpui_authoring</span> and installed with
        <span class="mono">Application::with_frame_pipeline</span>. Its default
        is
        <span class="mono">StandardImmediatePipeline</span> with the shipped
        <span class="mono">.max_fps(n)</span> and
        <span class="mono">.instrumented(metrics)</span> decorators — the frame
        governor the one-pager shows is that default configured, not a second
        implementation.
      </p>
    </div>

    <div class="card-grid three">
      {wraps.map((wrap) => (
        <article class="card">
          <div class="card-head">
            <h3 class="card-title mono">{wrap.name}</h3>
            <span class="card-badge">{wrap.badge}</span>
          </div>
          <p>{wrap.does}</p>
          <ul class="card-facts">
            {wrap.facts.map((fact) => (
              <li>{fact}</li>
            ))}
          </ul>
          <p class="card-note mono">lib: {wrap.lib}</p>
          {wrap.link ? (
            <a class="card-link" href={wrap.link}>
              {wrap.linkLabel} →
            </a>
          ) : null}
        </article>
      ))}
    </div>

    <div class="prose">
      <p>
        A wrap implements <span class="mono">FramePipeline</span> and delegates.
        Every pass has a default that calls the <span class="mono">Window</span>{" "}
        method behind it, so a decorator is only as transparent as the passes it
        explicitly forwards — which is the whole of the contract.
      </p>
    </div>

    <div class="callout">
      <span class="callout-title">Compose with any pipeline</span>
      <p>
        A wrap goes where any pipeline goes — the factory you hand to
        <span class="mono">with_frame_pipeline</span> — and stacks in any order
        and any number. Nothing in the tree is forked, so there is no patch to
        rebase when the engine moves. The published one is{" "}
        <a href="/pass">bite-gp-pass</a>, and{" "}
        <span class="mono">cargo add bite-gp-pass</span> is the whole of its
        install.
      </p>
    </div>
  </section>

  <section id="shove">
    <div class="section-head">
      <span class="kicker">Shove · The surface</span>
      <h2>Bring your own pixels.</h2>
      <p>
        A surface is content GPUI did not draw: a decoded video frame, a 3D
        viewport on its own device, or a texture computed off-thread. It
        replaces no seam and decorates no pipeline — it is an ordinary element
        that composites a foreign buffer with no CPU copy.
      </p>
    </div>

    <div class="prose">
      <ul class="checklist">
        <li>
          <strong>
            <span class="mono">surface(source)</span> takes what you already
            hold.
          </strong>
          A <span class="mono">SurfaceSource</span> is a CoreVideo buffer on
          Apple, a Direct3D texture or view on Windows, or a dma-buf on Linux,
          and the element fits it into its bounds with the same
          <span class="mono">ObjectFit</span> modes an image uses.
        </li>
        <li>
          <strong>
            <span class="mono">gpu_canvas(|ctx| …)</span> hands you the device.
          </strong>
          The callback receives a <span class="mono">GpuCanvasContext</span>:
          <span class="mono">paint_surface</span> for a handle you exported,
          <span class="mono">paint_texture</span> for a texture made on the
          window renderer’s own device, and
          <span class="mono">device::&lt;R&gt;()</span> to get that device.
        </li>
        <li>
          <strong>Nothing is frozen and nothing is installed.</strong> There is
          no <span class="mono">with_surface</span>: the element sits above the
          facade and the engine never learns what produced the pixels.
        </li>
        <li>
          <strong>The crates that build on it are public.</strong>
          <span class="mono">gpui_interop</span> bridges a producer’s own device
          (Linux dma-buf, Windows shared texture; macOS planned) and
          <span class="mono">gpui_video</span> is a hardware-decoded player on
          the same path.
        </li>
      </ul>
    </div>

    <div class="callout">
      <span class="callout-title">Two doors, and a cost for each</span>
      <p>
        A same-device texture is sampled with no export and no fence; an
        exported handle costs the producer a hand-off per frame. The measured
        difference, the platform matrix, and the 3D and video producers are on
        <a href="/shove">Bring your own surface</a>.
      </p>
    </div>
  </section>

  <section id="serve">
    <div class="section-head">
      <span class="kicker">Serve · The host</span>
      <h2>Use one of ours, or bring your own.</h2>
      <p>
        The platform is the seam the application does not switch at runtime: it
        is chosen when the app is built, and it supplies the event loop,
        windows, displays, clipboard and input. Four ship; a platform of your
        own is an <span class="mono">impl</span>, not a fork.
      </p>
    </div>

    <div class="table-card">
      <div class="table-head">
        <span class="table-head-title">The platforms that ship</span>
        <span class="table-head-note">
          one backend per build, selected by cfg
        </span>
      </div>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>platform</th>
              <th>backend</th>
              <th>selected by</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <span class="mono">macOS</span>
              </td>
              <td>MacPlatform over gpui_apple’s Metal renderer</td>
              <td>
                <span class="mono">cfg(target_os = "macos")</span>
              </td>
            </tr>
            <tr>
              <td>
                <span class="mono">Windows</span>
              </td>
              <td>WindowsPlatform over Direct3D 11</td>
              <td>
                <span class="mono">cfg(target_os = "windows")</span>
              </td>
            </tr>
            <tr>
              <td>
                <span class="mono">Linux</span>
              </td>
              <td>LinuxPlatform over X11 or Wayland, and gpui_wgpu</td>
              <td>
                <span class="mono">cfg(any(linux, freebsd))</span>
              </td>
            </tr>
            <tr>
              <td>
                <span class="mono">Web</span>
              </td>
              <td>WebPlatform on wasm32, through wgpu to WebGPU</td>
              <td>
                <span class="mono">cfg(target_family = "wasm")</span>
              </td>
            </tr>
            <tr>
              <td>
                <span class="mono">Headless</span>
              </td>
              <td>the test platform and the headless Linux platform</td>
              <td>
                <span class="mono">test-support</span>, or{" "}
                <span class="mono">ZED_HEADLESS</span>
              </td>
            </tr>
            <tr>
              <td>
                <span class="mono">iOS · Android</span>
              </td>
              <td>
                the third-party <span class="mono">gpui-mobile</span> crate, not
                yet ported to these crates
              </td>
              <td>
                its own <span class="mono">Platform</span> impl
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="table-note">
        The hook is <span class="mono">Application::with_platform</span>, and
        the trait is declared in <span class="mono">gpui_platform</span> — the
        leaf that links no drivers. What a platform owns, and what bringing one
        takes, is on <a href="/serve">Bring your own platform</a>.
      </p>
    </div>
  </section>

  <section>
    <div class="section-head">
      <span class="kicker">Installation</span>
      <h2>A swap is installed, not applied.</h2>
      <p>
        The two published swaps are ordinary crate dependencies. Nothing in the
        tree is forked, so there is no patch to rebase when the engine moves —
        and because each published package keeps its library target name,
        <span class="mono">use gpui_parley::…</span> and
        <span class="mono">use gpui_morphorm::…</span> are what your code
        already says.
      </p>
    </div>

    <CodeTabs
      panes={[
        { label: "Cargo.toml", html: cargo },
        { label: "src/main.rs", html: main },
      ]}
    />

    <div class="prose">
      <ul class="checklist">
        <li>
          <strong>The trait stays where it is.</strong> It is declared in a
          layer crate — <span class="mono">gpui_engine</span> for three of the
          five — so implementing it is an <span class="mono">impl</span> in your
          crate, not an edit to somebody else's.
        </li>
        <li>
          <strong>
            The hook is one method, called before the first window.
          </strong>{" "}
          A layout engine and a frame pipeline take factories because both are
          per-window; a text system is one
          <span class="mono">Arc</span> for the process.
        </li>
        <li>
          <strong>The library target name is preserved.</strong> The package is
          namespaced, the library is not, so an existing
          <span class="mono">use</span> line keeps compiling and the manifest is
          the only thing that moves.
        </li>
        <li>
          <strong>Each swap lives in a repository of its own</strong>, with the
          publisher that releases it, so it versions independently of the engine
          it plugs into.
        </li>
      </ul>
    </div>
  </section>

  <section id="open-seams">
    <div class="section-head">
      <span class="kicker">Open seams</span>
      <h2>What it takes to build a new backend.</h2>
      <p>
        We explicitly document the three unbuilt seams so external contributors
        know exactly where the architectural boundaries lie:
      </p>
    </div>

    <div class="table-card">
      <div class="table-head">
        <span class="table-head-title">
          What a second implementation would take
        </span>
        <span class="table-head-note">
          filed as usage projects, not as crates
        </span>
      </div>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>seam</th>
              <th>what it would take</th>
              <th>filed as</th>
            </tr>
          </thead>
          <tbody>
            {open.map((row) => (
              <tr>
                <td>
                  <span class="mono">{row.seam}</span>
                </td>
                <td>{row.take}</td>
                <td>
                  <span class="pill flat">{row.project}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">
        These are the categories the project files its own work under — a new
        flavour of a swappable, a decorator, a new authoring surface — and
        <a href="/demos">the demos page</a> carries the whole taxonomy with what
        each category is for.
      </p>
    </div>

    <div class="callout">
      <span class="callout-title">The two that ship instead</span>
      <p>
        The wgpu renderer and the frame governor are on the one-pager's shelf,
        but neither is a swap: <code>WgpuRenderer</code> is the scene renderer
        the Linux platform installs, and the governor is
        <code>StandardImmediatePipeline.max_fps(60)</code> with
        <code>.instrumented(…)</code> — shipped decorators, configured rather
        than installed. The seam that replaces the renderer is
        <code>SceneRenderer</code>, and it has no hook yet.
      </p>
    </div>
  </section>

  <section>
    <div class="section-head">
      <span class="kicker">Limits</span>
      <h2>Two of five, not five of five.</h2>
    </div>
    <div class="prose">
      <ul class="checklist">
        <li>
          <strong>The shelf is intentionally sparse:</strong> We only publish an
          alternate crate when there is a distinct, measurable performance or
          feature advantage. We don't build duplicate backends for the sake of
          checking boxes.
        </li>
        <li>
          <strong>Swaps are independent decisions:</strong>{" "}
          <span class="mono">bite-gp-parley</span> and{" "}
          <span class="mono">bite-gp-morphorm</span> operate on entirely
          different pipeline phases. You can use either one alone, combine both,
          or keep the defaults. Neither implies or requires the other.
        </li>
        <li>
          <strong>Every swap involves a trade-off:</strong> Parley adds BiDi
          layout and font fallback at the cost of slightly higher per-glyph
          instantiation overhead. Morphorm cuts layout frame time by up to 3.8×,
          but omits complex CSS Grid track rules.
        </li>
        <li>
          <strong>
            A wrap is the frame pipeline, and only the frame pipeline:
          </strong>{" "}
          <span class="mono">FramePipeline</span> is the one seam that hands a
          crate the frame's passes, so a decorator on
          <span class="mono">TextSystem</span> or{" "}
          <span class="mono">LayoutEngine</span> would have to be the
          implementation — which is a swap.
        </li>
      </ul>
    </div>

    <div class="callout">
      <span class="callout-title">Compose them on the one-pager</span>
      <p>
        The <a href="/#capabilities">Combo Studio</a> is the interactive version
        of this shelf: it stacks the add-ons and the platform backend, and shows
        the
        <code>main.rs</code> they produce. Two of its four add-ons are the
        published crates above; the others are shipped configuration, as the
        panel itself says.
      </p>
    </div>
  </section>

  <section>
    <div class="section-head">
      <span class="kicker">Where they live</span>
      <h2>The published crates.</h2>
      <p>
        The four crates, and the repositories they are developed and released
        from.
      </p>
    </div>

    <div class="artifact-grid">
      {artifacts.map((artifact) => (
        <a
          class="artifact"
          href={artifact.href}
          target="_blank"
          rel="noreferrer"
        >
          <span>
            <span class="artifact-name">{artifact.name}</span>
            <span class="artifact-desc">{artifact.desc}</span>
          </span>
          <span class="artifact-go">→</span>
        </a>
      ))}
    </div>
  </section>
</Page>
