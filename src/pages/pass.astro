<script>
  // The crate's admission rule, transcribed from `tests/throttling.rs`: a
  // theoretical arrival time, one interval of slack as the burst, and a remainder
  // shorter than an interval carried rather than lost. The page runs it over five
  // seconds of a 60 Hz ask grid and reports what it admits.
  document.querySelectorAll("[data-sim]").forEach((root) => {
    const GRID_NS = Math.round(1e9 / 60); // the step the harness uses
    const ASKS = 300; // five seconds at 60 Hz
    const SECONDS = 5;

    const rates = [...root.querySelectorAll("[data-rate]")];
    const cost = root.querySelector("[data-sim-cost]");
    const costLabel = root.querySelector("[data-sim-cost-label]");
    const intervalOut = root.querySelector("[data-sim-interval]");
    const drawnOut = root.querySelector("[data-sim-drawn]");
    const deliveredOut = root.querySelector("[data-sim-delivered]");
    const deferredOut = root.querySelector("[data-sim-deferred]");
    const cadenceOut = root.querySelector("[data-sim-cadence]");
    const strip = root.querySelector("[data-sim-strip]");
    const verdict = root.querySelector("[data-sim-verdict]");
    if (!cost || !strip || !verdict) return;

    let currentRate = 24;
    const active = rates.find((button) =>
      button.classList.contains("is-active"),
    );
    if (active) currentRate = Number(active.dataset.rate);

    const schedule = (fps) => {
      const interval = Math.floor(1e9 / fps); // whole nanoseconds, as the crate stores it
      const tolerance = interval; // one interval of slack (allow_burst(2))
      let nextAllowed = 0;
      let admitted = 0;
      let last = null;
      const drawn = [];
      const gaps = [];
      for (let ask = 0; ask < ASKS; ask++) {
        const now = ask * GRID_NS;
        if (now + tolerance >= nextAllowed) {
          admitted++;
          if (last !== null) gaps.push(ask - last);
          last = ask;
          drawn.push(ask);
          nextAllowed = Math.max(nextAllowed, now) + interval;
        }
      }
      return { admitted, drawn, gaps };
    };

    const cadence = (gaps) => {
      if (gaps.length === 0) return "—";
      const unique = [...new Set(gaps)];
      if (unique.length === 1) {
        const n = unique[0];
        if (n === 1) return "every ask";
        const suffix = n === 2 ? "nd" : n === 3 ? "rd" : "th";
        return `every ${n}${suffix} ask`;
      }
      return `${gaps.slice(0, 10).join(",")}…`;
    };

    const render = () => {
      const result = schedule(currentRate);
      const intervalMs = 1e9 / currentRate / 1e6;
      const delivered = result.admitted / SECONDS;
      const passedOver = (ASKS - result.admitted) / ASKS;

      intervalOut.textContent = `${intervalMs.toFixed(2)} ms`;
      drawnOut.textContent = `${result.admitted} / ${ASKS}`;
      deliveredOut.textContent = `${delivered.toFixed(1)} fps`;
      deferredOut.textContent = `${(passedOver * 100).toFixed(1)}%`;
      cadenceOut.textContent = cadence(result.gaps);

      strip.replaceChildren();
      const drawnSet = new Set(result.drawn);
      for (let ask = 0; ask < ASKS; ask++) {
        const cell = document.createElement("i");
        if (drawnSet.has(ask)) cell.dataset.drawn = "true";
        strip.appendChild(cell);
      }

      const ms = Number(cost.value);
      costLabel.textContent = `${ms.toFixed(1)} ms`;
      if (ms > intervalMs) {
        verdict.textContent = `A ${ms.toFixed(1)} ms pass overruns a ${intervalMs.toFixed(2)} ms interval: the passes alone eat the frame, and there is nothing left to present it.`;
        verdict.classList.add("is-over");
      } else {
        verdict.textContent = `A ${ms.toFixed(1)} ms pass fits a ${intervalMs.toFixed(2)} ms interval — but remember the budget covers the passes, not the platform presenting them.`;
        verdict.classList.remove("is-over");
      }
    };

    rates.forEach((button) => {
      button.addEventListener("click", () => {
        currentRate = Number(button.dataset.rate);
        rates.forEach((other) =>
          other.classList.toggle("is-active", other === button),
        );
        render();
      });
    });
    cost.addEventListener("input", render);
    render();
  });
</script>
