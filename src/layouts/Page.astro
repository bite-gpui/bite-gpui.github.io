---
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

// The shell every sub-page shares. The one-page marketing story stays where it
// is; these pages are the long-form material a reader lands on afterwards, so
// they reuse Nav and Footer rather than inventing a second chrome.
//
// `stats` is optional and renders as the hairline-divided strip under the lede —
// the guide's own claim in three figures, before the first section argues it.
const { title, description, kicker, heading, accent, lede, current, stats } =
  Astro.props;
---

<Layout title={title} description={description}>
  <Nav current={current} />
  <main class="page">
    <header class="page-hero">
      <div class="container">
        <span class="kicker">{kicker}</span>
        <h1>
          {heading}
          {accent ? (
            <>
              {" "}
              <em>{accent}</em>
            </>
          ) : null}
        </h1>
        <p class="lede">{lede}</p>
        {stats?.length ? (
          <div class="stat-strip">
            {stats.map(
              (stat: { value: string; label: string; win?: boolean }) => (
                <div class="stat">
                  <span class={`stat-value${stat.win ? " is-win" : ""}`}>
                    {stat.value}
                  </span>
                  <span class="stat-label">{stat.label}</span>
                </div>
              ),
            )}
          </div>
        ) : null}
      </div>
    </header>
    <div class="container page-body">
      <slot />
    </div>
  </main>
  <Footer />
</Layout>
